// aliasing.genexpr - v0.1 core of the Aliasing device (devices/aliasing).
// Source of truth for aliasing.gendsp (generated by tools/check.sh; never edit the .gendsp).
// Design: docs/port-decisions.md section 1 (Q4-Q8, Q15) and docs/signal-flow.md section 2.
// The tone section (notch, filters, drive) is v0.2 and not in this file yet.
//
// Mechanism: per voice, a write pointer and a read pointer run at their own pitches. The read
// phase (0..1) is written into the voice's table row at the write position, then the row is read
// at the read position; the output is 2v - 1. Pointers are naive (not band-limited) on purpose:
// the errors are the sound.
//
// Inlets   in1  MIDI gate (signal, 1 while any note is held); ORed with Param activate
//          in2  sync trigger (signal; a rising edge above 0.5, e.g. click~ from the Sync button)
// Outlets  out1, out2  stereo sum, after the safety stage
// Buffers  atab    bound by the shell: gen~ @atab ---atab   (5 ch x 1024 samples, float32);
//                  channel = voice, the table the DSP and the v8ui display share
//          aheads  bound by the shell: gen~ @aheads ---aheads (3 ch x 5 samples);
//                  per voice (sample = voice): ch 0 write head, ch 1 read head (0..1 of the
//                  row), ch 2 write enable (0/1); read by the display
// The default names below are placeholders: without the shell's attributes nothing is heard.

// Asymmetric triangle 0..1..0 over one phase p in [0, 1), peak at p = a.
// a = 1: rising ramp, a = 0.5: triangle, a = 0: falling ramp.
// Branch-free on purpose (no ?:, no if): its result is written by poke, and Max 9.1.x fails on
// user functions with a branch inside a poke value (gen-pitfalls, gen2.dsp.Model:1455).
skewtri(p, a) {
	up = p / max(a, 1e-9) + (a < 1e-9);
	down = (1 - p) / max(1 - a, 1e-9);
	return min(up, down);
}

// Global. Defaults = init state (redesign R21): write 71 + 0.217 st = 16004 Hz = fs/3 + 4 Hz at
// 48 kHz, read -30 st, spread 2, Size 0.1: the aliasing regime of the original (table-behaviour.md).
Param activate(0, min = 0, max = 1);
Param transpose(0, min = -12, max = 12);
Param size(0.1, min = 0.001, max = 1);
Param width(1, min = 0, max = 2);
Param output(-6, min = -36, max = 0);
Param smoothread(0, min = 0, max = 1);
// Write pointer
Param wpitch(71, min = -64, max = 130);   // R20: like the original; above ~fs/2 the pattern depends on fs
Param wfine(0.217, min = -1, max = 1);
Param wshape(1, min = 0, max = 2);
Param wsym(0, min = -1, max = 1);
Param wactive(1, min = 0, max = 1);
Param wlforate(0, min = 0, max = 12);
Param wlfodepth(0, min = 0, max = 1);
// Read pointer
Param rpitch(-30, min = -64, max = 64);
Param rfine(0, min = -1, max = 1);
Param rshape(0, min = 0, max = 1);
Param rdir(0, min = 0, max = 1);
Param rspread(2, min = 0, max = 6);
Param rlforate(0, min = 0, max = 12);
Param rlfodepth(0, min = 0, max = 1);

Buffer atab("aliasing_atab_unbound");
Buffer aheads("aliasing_aheads_unbound");
// Per-voice state (sample = voice): ch 0 write phase, ch 1 read phase,
// ch 2 write LFO phase, ch 3 read LFO phase. 64-bit (Q4).
Data st(8, 4);
History inited(0);
History prevgate(0);
History prevsync(0);
History smw(0);
History smr(0);
History smgain(0);
History genv(0);

NV = 5;      // NVOICES (Q7); the voice formulas below derive from it
N = 1024;    // table cells per voice row (Q6)
c = 0;
i = 0;
v = 0;

// Gate: Activate parameter OR a held MIDI note (Q2). A rising edge of the gate or of the sync
// input restarts both pointer phases of every voice (the original's Snc = G).
gon = max(activate > 0.5, in1 > 0.5);
syn = in2 > 0.5;
restart = max(gon > prevgate, syn > prevsync);
we = gon * (wactive > 0.5);

// Initial table: identity ramp T(x) = x per row, written once after load (Q3, Q15).
if (inited < 0.5) {
	for (c = 0; c < NV; c += 1) {
		for (i = 0; i < N; i += 1) {
			poke(atab, i / N, i, c, 0);
		}
	}
}

// Pitch smoothing (~15 ms one-pole, Q5) against zipper noise under automation. Snaps to the
// target on load and on a restart, so Sync starts both pointers at exactly the same pitch.
k = 1 - exp(-1 / (0.015 * samplerate));
snap = max(restart, inited < 0.5);
tw = wpitch + wfine + transpose;
tr = rpitch + rfine + transpose;
pw = snap ? tw : smw + (tw - smw) * k;
pr = snap ? tr : smr + (tr - smr) * k;
// Output level: Output dB plus the voice-count compensation 20*log10(1/NV), smoothed.
tgain = dbtoa(output) / NV;
g = (inited < 0.5) ? tgain : smgain + (tgain - smgain) * k;
// Declick gate (~5 ms one-pole on the gate). Not in the original (Q1 deviation): with the gate
// off the read position is 0, so every voice reads cell 0 and outputs a constant 2*T(0) - 1,
// i.e. DC. The envelope makes "not activated" silent and softens the on/off steps.
ke = 1 - exp(-1 / (0.005 * samplerate));
env = genv + (gon - genv) * ke;

asym = (1 + wsym) * 0.5;              // write Tri: Symmetry -1..1 -> peak position 0..1
rsym = (rdir > 0.5) ? 0.5 : 1;        // read Tri: one-way = rising ramp, both = triangle
lw = pow(wlfodepth, 5);               // LFO depth curve depth^5 semitones
lr = pow(rlfodepth, 5);

sumL = 0;
sumR = 0;
for (v = 0; v < NV; v += 1) {
	pos = (v - (NV - 1) * 0.5) / ((NV - 1) * 0.5);   // -1..1 across the voices
	u = (pos + 1) * 0.5;                              // 0..1

	// LFOs: free-running audio-rate sines, F = rate * (rate + u)
	lpw = peek(st, v, 2, interp = "none", boundmode = "ignore");
	lpr = peek(st, v, 3, interp = "none", boundmode = "ignore");
	lfow = lw * sin(twopi * lpw);
	lfor = lr * sin(twopi * lpr);
	poke(st, wrap(lpw + wlforate * (wlforate + u) / samplerate, 0, 1), v, 2, 0);
	poke(st, wrap(lpr + rlforate * (rlforate + u) / samplerate, 0, 1), v, 3, 0);

	// Pointer pitches around note 60; read spread (V - 0.5)/Vcs - 0.5 with V = v + 1
	notew = 60 + pw + lfow;
	noter = 60 + pr + rspread * ((v + 0.5) / NV - 0.5) + lfor;

	// Pointer phases (naive accumulators, restart -> 0)
	phw = restart ? 0 : peek(st, v, 0, interp = "none", boundmode = "ignore");
	phr = restart ? 0 : peek(st, v, 1, interp = "none", boundmode = "ignore");
	poke(st, wrap(phw + mtof(notew) / samplerate, 0, 1), v, 0, 0);
	poke(st, wrap(phr + mtof(noter) / samplerate, 0, 1), v, 1, 0);

	// Shapes. Write Tri stays -1..1 (not rescaled) and wraps on write; read Tri is 0..1.
	triw = 2 * skewtri(phw, asym) - 1;
	tri01 = skewtri(phr, rsym);
	rd = (rshape > 0.5) ? tri01 : phr;                          // read phase = written data
	xw = (wshape < 0.5) ? phw : ((wshape < 1.5) ? triw : rd);   // Ramp / Tri / =Read
	wpos = xw * size;
	rpos = rd * gon * size;                                    // 0 while not activated

	// Same-sample order: WRITE first, then READ (statement order is the order in GenExpr).
	// Write index: floor, then wrap into the row.
	wi = wrap(floor(wpos * N), 0, N);
	if (we > 0.5) {
		poke(atab, rd, wi, v, 0);
	}
	// Read: no interpolation by default; Smooth = linear between cell i0 and i0 + 1, wrapping
	// across the seam explicitly (no reliance on peek's own interpolation/bound modes).
	ri = rpos * N;
	i0 = floor(ri);
	fr = ri - i0;
	a0 = peek(atab, wrap(i0, 0, N), v, interp = "none", boundmode = "ignore");
	a1 = peek(atab, wrap(i0 + 1, 0, N), v, interp = "none", boundmode = "ignore");
	val = (smoothread > 0.5) ? a0 + (a1 - a0) * fr : a0;
	y = 2 * val - 1;

	// Equal-power pan, width * pos(V), clamped to -1..1
	pan = clamp(width * pos, -1, 1);
	ang = (pan + 1) * pi * 0.25;
	sumL += y * cos(ang);
	sumR += y * sin(ang);

	// Display heads (0..1 of the row)
	poke(aheads, wi / N, v, 0, 0);
	poke(aheads, rpos, v, 1, 0);
	poke(aheads, we, v, 2, 0);
}

smw = pw;
smr = pr;
smgain = g;
genv = env;
prevgate = gon;
prevsync = syn;
inited = 1;

// Safety stage (development builds): no NaN/inf/denormals, hard clip to -1..1.
out1 = clip(fixdenorm(fixnan(sumL * g * env)), -1, 1);
out2 = clip(fixdenorm(fixnan(sumR * g * env)), -1, 1);

// aliasing.genexpr - v0.3 DSP of the Aliasing device (devices/aliasing).
// Source of truth for aliasing.gendsp (generated by tools/check.sh; never edit the .gendsp).
// Design: docs/port-decisions.md (Q1-Q9, Q15), docs/redesign-t1.md (R1-R4, R16-R24), the v0.2
// build notes (docs/v0.2-build.md, A1-A33) and the v0.3 design (docs/v0.3-design.md, D1-D30).
//
// Mechanism (unchanged from v0.1): per voice a write pointer and a read pointer run at their own
// rates. The read phase (0..1) is written into the voice's table row at the write position, then
// the row is read at the read position; the core signal is 2v - 1. Pointers are naive by default
// (the errors are the sound); an anti-aliased ramp is an option (R24). The write shape sets the
// write head's path (8 shapes, D4); the write state is Freeze / Write / Clean (D5), and a mod
// matrix (9 sources x 12 targets, D10) can gate writing per voice (D15).
// Per voice after the core: Drive -> Band (coupled HP + LP, FM from the core) -> Resonator (comb),
// each switchable (D17) -> pan. Then sum, Output, DC blocker, envelope follower tap (D16), color
// limiter (D19), safety stage.
//
// Inlets   in1  MIDI gate (signal, 1 while any note is held)
//          in2  Sync impulse (click~ from the Sync button): restarts both pointers
//          in3  note-on impulse (click~ on every note-on): LFO retrigger "Note"; in MIDI gate mode
//               it also restarts both pointers (R1)
//          in4  bar ramp (phasor~ 1.0.0 @lock 1: 0..1 per bar while Live's transport runs)
// Outlets  out1, out2  stereo, after the safety stage
//          out3        envelope follower source value 0..1 (for the Env meter on the LFO · Env page)
// Buffers  atab    bound by the shell: gen~ @atab ---atab    (5 ch x 1024 samples, float32);
//                  channel = voice, the table that the DSP and the v8ui display share
//          aheads  bound by the shell: gen~ @aheads ---aheads (10 ch x 5 samples), display data per
//                  voice (sample = voice): ch 0 write head, ch 1 read head (0..1 of the row), ch 2 write
//                  enable, ch 3 effective Size, ch 4 write Hz, ch 5 read Hz, ch 6 band centre Hz
//                  (without FM), ch 7 band width in octaves, ch 8 resonator Hz; ch 9 globals:
//                  sample 0 samplerate, sample 1 table-valid flag (written by the display script when
//                  it restores a stored table; read here once at load), sample 2 gate envelope,
//                  sample 3 tempo in BPM, sample 4 transport playing
// The default buffer names are placeholders: without the shell's attributes nothing is heard.

// Asymmetric triangle 0..1..0 over one phase p in [0, 1), peak at p = a.
// a = 1: rising ramp, a = 0.5: triangle, a = 0: falling ramp.
// Branch-free on purpose (no ?:, no if): Max 9.1.x fails on user functions with a branch inside a
// poke value (gen-pitfalls, gen2.dsp.Model:1455); results are put into variables before any poke.
skewtri(p, a) {
	up = p / max(a, 1e-9) + (a < 1e-9);
	down = (1 - p) / max(1 - a, 1e-9);
	return min(up, down);
}

// PolyBLEP residual of a 0..1 ramp at phase p with phase increment dt (R24). dt is clamped to 0.5:
// above fs/2 the pointer aliases anyway and the correction only has to stay finite. Branch-free.
blep(p, dt) {
	bd = clamp(dt, 1e-9, 0.5);
	bt1 = p / bd;
	bt2 = (p - 1) / bd;
	ba = (p < bd) * (bt1 + bt1 - bt1 * bt1 - 1);
	bb = (p > 1 - bd) * (bt2 * bt2 + bt2 + bt2 + 1);
	return ba + bb;
}

// Park-Miller step on an integer seed held in a double (exact: 16807 * 2^31 < 2^53).
lcg(s) {
	return (s * 16807) % 2147483647;
}

// LFO shapes on phase p (0..1), bipolar -1..1. sh: 0 sine, 1 triangle, 2 saw, 3 square,
// 4 sample and hold (rb = value of this cycle), 5 smooth random (ra -> rb over the cycle).
lfoshape(p, sh, ra, rb) {
	ls0 = sin(twopi * p);
	ls1 = 1 - 4 * abs(wrap(p + 0.25, 0, 1) - 0.5);
	ls2 = 2 * p - 1;
	ls3 = 1 - 2 * (p >= 0.5);
	ls5 = ra + (rb - ra) * (0.5 - 0.5 * cos(pi * p));
	return (sh < 0.5) * ls0 + (sh >= 0.5) * (sh < 1.5) * ls1 + (sh >= 1.5) * (sh < 2.5) * ls2
		+ (sh >= 2.5) * (sh < 3.5) * ls3 + (sh >= 3.5) * (sh < 4.5) * rb + (sh >= 4.5) * ls5;
}

// ---- Parameters (names = the shell's "prepend <name>" messages) ----
// Defaults = the init state: write and read at 0 st (D1), write Tri, Size 0.1. The v0.2 init sound
// (write 71 + 0.217 st, read -30 st, R21) becomes a preset in v0.4.
// Global page
Param gatemode(0, min = 0, max = 1);      // R1: 0 Drone, 1 MIDI
Param resync(0, min = 0, max = 4);        // R2: Off, 1, 2, 4, 8 bars
Param transpose(0, min = -48, max = 48);  // D21
Param width(1, min = 0, max = 2);
Param output(-6, min = -36, max = 0);
Param aaramp(0, min = 0, max = 1);        // R24: anti-aliased ramps for both pointers
Param size(0.1, min = 0.001, max = 1);
// Color limiter (D19, D28)
Param limon(1, min = 0, max = 1);
Param limgain(0, min = 0, max = 24);      // dB into the limiter
Param limsat(0, min = 0, max = 100);      // percent
Param limcolor(0, min = -100, max = 100); // percent: - lows, + highs drive the saturation
Param limrel(100, min = 1, max = 1000);   // ms
Param limceil(-0.3, min = -12, max = 0);  // dB
// Envelope follower (D16, D27)
Param enatt(5, min = 0.1, max = 100);     // ms
Param enrel(150, min = 10, max = 2000);   // ms
Param engain(12, min = -24, max = 24);    // dB
// Host and MIDI state, set by the shell (not Live parameters)
Param playing(0, min = 0, max = 1);       // plugsync~ transport state
Param spb(0, min = 0, max = 1000000);     // plugsync~ samples per beat (0 = unknown -> 120 BPM)
Param velocity(0, min = 0, max = 1);      // last note-on velocity / 127
Param modwheel(0, min = 0, max = 1);      // CC 1 / 127
// Write pointer
Param wmode(0, min = 0, max = 1);         // R2: 0 Free, 1 Sync
Param wpitch(0, min = -64, max = 130);    // D1; R20: above ~fs/2 the pattern depends on fs
Param wnote(13, min = 0, max = 18);       // note value index (divb below)
Param wmult(1, min = 1, max = 128);       // D3: x N
Param wden(1, min = 1, max = 32);         // D3: / D
Param wfine(0, min = -1, max = 1);        // Free: fine; Sync: detune against the grid
Param wsym(0, min = -1, max = 1);         // the shape's parameter (D6)
Param wshape(1, min = 0, max = 7);        // D4: Ramp, Tri, Tri +-, Sine, Pulse, Pulsar, Spike, Noise
Param wactive(1, min = 0, max = 2);       // D5: Freeze, Write, Clean (= the original's "=read")
// Read pointer
Param rmode(0, min = 0, max = 1);
Param rpitch(0, min = -64, max = 130);    // D1
Param rnote(13, min = 0, max = 18);
Param rmult(1, min = 1, max = 128);
Param rden(1, min = 1, max = 32);
Param rfine(0, min = -1, max = 1);
Param rspread(2, min = 0, max = 6);
Param rshape(0, min = 0, max = 1);        // Ramp, Tri
Param rdir(0, min = 0, max = 1);          // Tri: one way (rising) or both
Param smoothread(0, min = 0, max = 1);
// LFOs (R3)
Param l1mode(0, min = 0, max = 1);
Param l1rate(0.15, min = 0.01, max = 20);
Param l1note(7, min = 0, max = 18);
Param l1phase(0, min = 0, max = 360);
Param l1spread(50, min = 0, max = 100);
Param l1shape(0, min = 0, max = 5);
Param l1retrig(0, min = 0, max = 2);      // Off, Note, Bar
Param l2mode(1, min = 0, max = 1);
Param l2rate(0.07, min = 0.01, max = 20);
Param l2note(3, min = 0, max = 18);
Param l2phase(90, min = 0, max = 360);
Param l2spread(50, min = 0, max = 100);
Param l2shape(5, min = 0, max = 5);
Param l2retrig(2, min = 0, max = 2);
// Mod matrix (D10-D15, D26): mx_<source>_<target>, depth in percent.
// Sources: l1 LFO 1, l2 LFO 2, en Env follower, dr Drift, ve Velocity, mw Mod Wheel,
//          vo Voice (own raw core, 1 sample late), nb Neighbour (next voice's raw core), ro Read Osc.
// Targets: wp Write Pitch, rp Read Pitch, sz Size, sy Write Sym, sp Read Spread, wa Write (gate),
//          dv Drive, bc Band Center, bw Band Width, rf Res Freq, rb Res Fdbk, ou Output.
Param mx_l1_wp(0, min = -100, max = 100); Param mx_l1_rp(0, min = -100, max = 100); Param mx_l1_sz(0, min = -100, max = 100);
Param mx_l1_sy(0, min = -100, max = 100); Param mx_l1_sp(0, min = -100, max = 100); Param mx_l1_wa(0, min = -100, max = 100);
Param mx_l1_dv(0, min = -100, max = 100); Param mx_l1_bc(0, min = -100, max = 100); Param mx_l1_bw(0, min = -100, max = 100);
Param mx_l1_rf(0, min = -100, max = 100); Param mx_l1_rb(0, min = -100, max = 100); Param mx_l1_ou(0, min = -100, max = 100);
Param mx_l2_wp(0, min = -100, max = 100); Param mx_l2_rp(0, min = -100, max = 100); Param mx_l2_sz(0, min = -100, max = 100);
Param mx_l2_sy(0, min = -100, max = 100); Param mx_l2_sp(0, min = -100, max = 100); Param mx_l2_wa(0, min = -100, max = 100);
Param mx_l2_dv(0, min = -100, max = 100); Param mx_l2_bc(0, min = -100, max = 100); Param mx_l2_bw(0, min = -100, max = 100);
Param mx_l2_rf(0, min = -100, max = 100); Param mx_l2_rb(0, min = -100, max = 100); Param mx_l2_ou(0, min = -100, max = 100);
Param mx_en_wp(0, min = -100, max = 100); Param mx_en_rp(0, min = -100, max = 100); Param mx_en_sz(0, min = -100, max = 100);
Param mx_en_sy(0, min = -100, max = 100); Param mx_en_sp(0, min = -100, max = 100); Param mx_en_wa(0, min = -100, max = 100);
Param mx_en_dv(0, min = -100, max = 100); Param mx_en_bc(0, min = -100, max = 100); Param mx_en_bw(0, min = -100, max = 100);
Param mx_en_rf(0, min = -100, max = 100); Param mx_en_rb(0, min = -100, max = 100); Param mx_en_ou(0, min = -100, max = 100);
Param mx_dr_wp(0, min = -100, max = 100); Param mx_dr_rp(0, min = -100, max = 100); Param mx_dr_sz(0, min = -100, max = 100);
Param mx_dr_sy(0, min = -100, max = 100); Param mx_dr_sp(0, min = -100, max = 100); Param mx_dr_wa(0, min = -100, max = 100);
Param mx_dr_dv(0, min = -100, max = 100); Param mx_dr_bc(0, min = -100, max = 100); Param mx_dr_bw(0, min = -100, max = 100);
Param mx_dr_rf(0, min = -100, max = 100); Param mx_dr_rb(0, min = -100, max = 100); Param mx_dr_ou(0, min = -100, max = 100);
Param mx_ve_wp(0, min = -100, max = 100); Param mx_ve_rp(0, min = -100, max = 100); Param mx_ve_sz(0, min = -100, max = 100);
Param mx_ve_sy(0, min = -100, max = 100); Param mx_ve_sp(0, min = -100, max = 100); Param mx_ve_wa(0, min = -100, max = 100);
Param mx_ve_dv(0, min = -100, max = 100); Param mx_ve_bc(0, min = -100, max = 100); Param mx_ve_bw(0, min = -100, max = 100);
Param mx_ve_rf(0, min = -100, max = 100); Param mx_ve_rb(0, min = -100, max = 100); Param mx_ve_ou(0, min = -100, max = 100);
Param mx_mw_wp(0, min = -100, max = 100); Param mx_mw_rp(0, min = -100, max = 100); Param mx_mw_sz(0, min = -100, max = 100);
Param mx_mw_sy(0, min = -100, max = 100); Param mx_mw_sp(0, min = -100, max = 100); Param mx_mw_wa(0, min = -100, max = 100);
Param mx_mw_dv(0, min = -100, max = 100); Param mx_mw_bc(0, min = -100, max = 100); Param mx_mw_bw(0, min = -100, max = 100);
Param mx_mw_rf(0, min = -100, max = 100); Param mx_mw_rb(0, min = -100, max = 100); Param mx_mw_ou(0, min = -100, max = 100);
Param mx_vo_wp(0, min = -100, max = 100); Param mx_vo_rp(0, min = -100, max = 100); Param mx_vo_sz(0, min = -100, max = 100);
Param mx_vo_sy(0, min = -100, max = 100); Param mx_vo_sp(0, min = -100, max = 100); Param mx_vo_wa(0, min = -100, max = 100);
Param mx_vo_dv(0, min = -100, max = 100); Param mx_vo_bc(0, min = -100, max = 100); Param mx_vo_bw(0, min = -100, max = 100);
Param mx_vo_rf(0, min = -100, max = 100); Param mx_vo_rb(0, min = -100, max = 100); Param mx_vo_ou(0, min = -100, max = 100);
Param mx_nb_wp(0, min = -100, max = 100); Param mx_nb_rp(0, min = -100, max = 100); Param mx_nb_sz(0, min = -100, max = 100);
Param mx_nb_sy(0, min = -100, max = 100); Param mx_nb_sp(0, min = -100, max = 100); Param mx_nb_wa(0, min = -100, max = 100);
Param mx_nb_dv(0, min = -100, max = 100); Param mx_nb_bc(0, min = -100, max = 100); Param mx_nb_bw(0, min = -100, max = 100);
Param mx_nb_rf(0, min = -100, max = 100); Param mx_nb_rb(0, min = -100, max = 100); Param mx_nb_ou(0, min = -100, max = 100);
Param mx_ro_wp(0, min = -100, max = 100); Param mx_ro_rp(0, min = -100, max = 100); Param mx_ro_sz(0, min = -100, max = 100);
Param mx_ro_sy(0, min = -100, max = 100); Param mx_ro_sp(0, min = -100, max = 100); Param mx_ro_wa(0, min = -100, max = 100);
Param mx_ro_dv(0, min = -100, max = 100); Param mx_ro_bc(0, min = -100, max = 100); Param mx_ro_bw(0, min = -100, max = 100);
Param mx_ro_rf(0, min = -100, max = 100); Param mx_ro_rb(0, min = -100, max = 100); Param mx_ro_ou(0, min = -100, max = 100);
// Tone (R16-R18, D17)
Param drvon(1, min = 0, max = 1);            // section switches (D17)
Param bandon(1, min = 0, max = 1);
Param reson(0, min = 0, max = 1);
Param drive(0, min = 0, max = 24);           // dB
Param bcenter(632, min = 20, max = 20000);   // Hz
Param bwidth(10, min = 0.2, max = 10);       // octaves; 10 = open
Param bres(0, min = 0, max = 100);           // percent
Param bfm(0, min = 0, max = 100);            // percent: 100 = +-4 octaves per unit of core signal
Param bspread(25, min = 0, max = 100);       // percent: 100 = centres +-2 octaves across the voices
Param bslope(1, min = 0, max = 1);           // 12 dB, 24 dB
Param bmode(0, min = 0, max = 1);            // Pass, Reject
Param rsfreq(140, min = 20, max = 5000);     // Hz (fixed mode)
Param rsfb(50, min = -95, max = 95);         // percent: + peaks, - notches
Param rsmix(50, min = 0, max = 100);         // percent (the section switch bypasses, D17)
Param rstrack(1, min = 0, max = 1);          // follow the voice's read pointer frequency

Buffer atab("aliasing_atab_unbound");
Buffer aheads("aliasing_aheads_unbound");
// Per voice (sample = voice, 64-bit, Q4): ch 0 write phase, 1 read phase, 2 LFO 1 phase,
// 3 LFO 2 phase, 4 drift phase, 5 write flag (Write target hysteresis, D15).
Data ph(8, 6);
// Per voice random state: ch 0/1 LFO 1 previous/next, 2/3 LFO 2, 4/5 drift, 6 seed,
// 7/8 Noise write shape previous/next position (D4).
Data rnd(8, 9);
// Raw core signal per voice for the Voice / Neighbour sources (D12): ch 0 previous sample, ch 1
// this sample (copied to ch 0 after the voice loop, so every voice sees the same previous sample).
Data yfb(8, 2);
// Per voice filter states: 4 SVF stages x 2 (A1, A2 = lower edge, B1, B2 = upper edge).
Data flt(8, 8);
// Resonator delay lines, one channel per voice (16384 samples: 20 Hz down to 327 kHz).
Data cbuf(16384, 5);
// Note values in quarter-note beats (bars = 4/4).
Data divb(19, 1);
History inited(0);
History prevgate(0);
History prevsync(0);
History prevnote(0);
History prevplay(0);
History prevbar(0);
History barcount(0);
History smw(0);
History smr(0);
History smgain(0);
History smvel(0);
History smmw(0);
History genv(0);
History cwi(0);
History dcxl(0);
History dcyl(0);
History dcxr(0);
History dcyr(0);
History envf(0);     // envelope follower state (D16)
History envs(0);     // follower source value for the next sample's voices
History limg(1);     // limiter gain (D19)
History lpl1(0);     // limiter colour split, pre-emphasis (L, R) and de-emphasis (L, R)
History lpr1(0);
History lpl2(0);
History lpr2(0);
History sdrv(1);     // section switches, smoothed (D17)
History sband(1);
History sres(0);
History slim(1);

NV = 5;      // NVOICES (Q7); the voice formulas below derive from it
N = 1024;    // table cells per voice row (Q6)
CB = 16384;  // resonator delay line length
c = 0;
i = 0;
v = 0;
first = inited < 0.5;

// ---- one-time init (load / recompile) ----
// Identity table T(x) = x per row (Q15), unless the display script has already restored a stored
// table (flag in aheads ch 9 sample 1, R10).
if (first) {
	if (peek(aheads, 1, 9, interp = "none", boundmode = "ignore") < 0.5) {
		for (c = 0; c < NV; c += 1) {
			for (i = 0; i < N; i += 1) {
				poke(atab, i / N, i, c, 0);
			}
		}
	}
	poke(divb, 32, 0, 0, 0);
	poke(divb, 16, 1, 0, 0);
	poke(divb, 8, 2, 0, 0);
	poke(divb, 4, 3, 0, 0);
	poke(divb, 2, 4, 0, 0);
	poke(divb, 3, 5, 0, 0);
	poke(divb, 4 / 3, 6, 0, 0);
	poke(divb, 1, 7, 0, 0);
	poke(divb, 1.5, 8, 0, 0);
	poke(divb, 2 / 3, 9, 0, 0);
	poke(divb, 0.5, 10, 0, 0);
	poke(divb, 0.75, 11, 0, 0);
	poke(divb, 1 / 3, 12, 0, 0);
	poke(divb, 0.25, 13, 0, 0);
	poke(divb, 0.375, 14, 0, 0);
	poke(divb, 1 / 6, 15, 0, 0);
	poke(divb, 0.125, 16, 0, 0);
	poke(divb, 1 / 12, 17, 0, 0);
	poke(divb, 0.0625, 18, 0, 0);
	for (v = 0; v < NV; v += 1) {
		poke(rnd, 1000 + 7919 * (v + 1), v, 6, 0);
	}
}

// ---- gate, restarts, transport ----
gon = (gatemode > 0.5) ? (in1 > 0.5) : 1;          // R1: Drone always on, MIDI while a note is held
syn = in2 > 0.5;
non = in3 > 0.5;
syncedge = syn > prevsync;
noteedge = non > prevnote;
// Restart of both pointers: load, Sync button, note-on in MIDI mode (R1)
rsall = max(max(first, syncedge), noteedge * (gatemode > 0.5));
// Transport: start (playing 0 -> 1) and bar wraps of the locked bar ramp
isplay = playing > 0.5;
tstart = isplay * (prevplay < 0.5);
barwrap = isplay * (in4 < prevbar - 0.5);
bc = tstart ? 0 : barcount + barwrap;
nres = (resync < 0.5) ? 0 : ((resync < 1.5) ? 1 : ((resync < 2.5) ? 2 : ((resync < 3.5) ? 4 : 8)));
rsbar = barwrap * (nres > 0) * ((bc % max(nres, 1)) < 0.5);
// Restart of synced pointers only: transport start and the Resync bars (R2)
rssync = max(tstart, rsbar);
wrs = max(rsall, rssync * (wmode > 0.5));
rrs = max(rsall, rssync * (rmode > 0.5));
lbar = max(tstart, barwrap);                        // LFO retrigger "Bar"
wbase = wactive > 0.5;                              // Write or Clean (D5)
wclean = wactive > 1.5;                             // Clean: write position = read signal

// Tempo: beats per second from plugsync~ (samples per beat); 120 BPM until Live reports one.
spbv = (spb > 1) ? spb : samplerate * 0.5;
bhz = samplerate / spbv;

// ---- pointer pitches, smoothed (~15 ms, Q5); snap on load and on the Sync button ----
k = 1 - exp(-1 / (0.015 * samplerate));
snap = max(first, syncedge);
dbw = peek(divb, clamp(floor(wnote + 0.5), 0, 18), 0, interp = "none", boundmode = "ignore");
dbr = peek(divb, clamp(floor(rnote + 0.5), 0, 18), 0, interp = "none", boundmode = "ignore");
// Sync: note value x N / D at the current tempo (D3), Fine = detune (R2); Free: pitch around note 60
tw = (wmode > 0.5) ? ftom(wmult / wden * bhz / max(dbw, 0.0625)) + wfine : 60 + wpitch + wfine + transpose;
tr = (rmode > 0.5) ? ftom(rmult / rden * bhz / max(dbr, 0.0625)) + rfine : 60 + rpitch + rfine + transpose;
pw = snap ? tw : smw + (tw - smw) * k;
pr = snap ? tr : smr + (tr - smr) * k;
// Output level: Output dB plus the voice-count compensation 20*log10(1/NV), smoothed.
tgain = dbtoa(output) / NV;
g = first ? tgain : smgain + (tgain - smgain) * k;
// Declick gate (~5 ms one-pole on the gate, D1 in v0.1-core.md)
ke = 1 - exp(-1 / (0.005 * samplerate));
env = genv + (gon - genv) * ke;
vel = smvel + (velocity - smvel) * ke;
mw = smmw + (modwheel - smmw) * k;

// ---- LFO rates (per voice they are spread below) ----
db1 = peek(divb, clamp(floor(l1note + 0.5), 0, 18), 0, interp = "none", boundmode = "ignore");
db2 = peek(divb, clamp(floor(l2note + 0.5), 0, 18), 0, interp = "none", boundmode = "ignore");
f1 = (l1mode > 0.5) ? bhz / max(db1, 0.0625) : l1rate;
f2 = (l2mode > 0.5) ? bhz / max(db2, 0.0625) : l2rate;
re1 = ((l1retrig > 0.5) * (l1retrig < 1.5) * noteedge) + ((l1retrig >= 1.5) * lbar);
re2 = ((l2retrig > 0.5) * (l2retrig < 1.5) * noteedge) + ((l2retrig >= 1.5) * lbar);
po1 = l1phase / 360;
po2 = l2phase / 360;

// ---- mod matrix: depth coefficients (once per sample) and the global sources' share (D10-D15) ----
// Pitch targets (wp, rp) use the cubic curve 24 st x depth^3; the others are linear, scaled to their
// target units in the voice loop (D26). Global sources: Env (envs, last sample), Velocity, Mod Wheel.
c_l1_wp = 0.000024 * mx_l1_wp * mx_l1_wp * mx_l1_wp;
c_l2_wp = 0.000024 * mx_l2_wp * mx_l2_wp * mx_l2_wp;
c_en_wp = 0.000024 * mx_en_wp * mx_en_wp * mx_en_wp;
c_dr_wp = 0.000024 * mx_dr_wp * mx_dr_wp * mx_dr_wp;
c_ve_wp = 0.000024 * mx_ve_wp * mx_ve_wp * mx_ve_wp;
c_mw_wp = 0.000024 * mx_mw_wp * mx_mw_wp * mx_mw_wp;
c_vo_wp = 0.000024 * mx_vo_wp * mx_vo_wp * mx_vo_wp;
c_nb_wp = 0.000024 * mx_nb_wp * mx_nb_wp * mx_nb_wp;
c_ro_wp = 0.000024 * mx_ro_wp * mx_ro_wp * mx_ro_wp;
c_l1_rp = 0.000024 * mx_l1_rp * mx_l1_rp * mx_l1_rp;
c_l2_rp = 0.000024 * mx_l2_rp * mx_l2_rp * mx_l2_rp;
c_en_rp = 0.000024 * mx_en_rp * mx_en_rp * mx_en_rp;
c_dr_rp = 0.000024 * mx_dr_rp * mx_dr_rp * mx_dr_rp;
c_ve_rp = 0.000024 * mx_ve_rp * mx_ve_rp * mx_ve_rp;
c_mw_rp = 0.000024 * mx_mw_rp * mx_mw_rp * mx_mw_rp;
c_vo_rp = 0.000024 * mx_vo_rp * mx_vo_rp * mx_vo_rp;
c_nb_rp = 0.000024 * mx_nb_rp * mx_nb_rp * mx_nb_rp;
c_ro_rp = 0.000024 * mx_ro_rp * mx_ro_rp * mx_ro_rp;
c_l1_sz = mx_l1_sz * 0.01;
c_l2_sz = mx_l2_sz * 0.01;
c_en_sz = mx_en_sz * 0.01;
c_dr_sz = mx_dr_sz * 0.01;
c_ve_sz = mx_ve_sz * 0.01;
c_mw_sz = mx_mw_sz * 0.01;
c_vo_sz = mx_vo_sz * 0.01;
c_nb_sz = mx_nb_sz * 0.01;
c_ro_sz = mx_ro_sz * 0.01;
c_l1_sy = mx_l1_sy * 0.01;
c_l2_sy = mx_l2_sy * 0.01;
c_en_sy = mx_en_sy * 0.01;
c_dr_sy = mx_dr_sy * 0.01;
c_ve_sy = mx_ve_sy * 0.01;
c_mw_sy = mx_mw_sy * 0.01;
c_vo_sy = mx_vo_sy * 0.01;
c_nb_sy = mx_nb_sy * 0.01;
c_ro_sy = mx_ro_sy * 0.01;
c_l1_sp = mx_l1_sp * 0.01;
c_l2_sp = mx_l2_sp * 0.01;
c_en_sp = mx_en_sp * 0.01;
c_dr_sp = mx_dr_sp * 0.01;
c_ve_sp = mx_ve_sp * 0.01;
c_mw_sp = mx_mw_sp * 0.01;
c_vo_sp = mx_vo_sp * 0.01;
c_nb_sp = mx_nb_sp * 0.01;
c_ro_sp = mx_ro_sp * 0.01;
c_l1_wa = mx_l1_wa * 0.01;
c_l2_wa = mx_l2_wa * 0.01;
c_en_wa = mx_en_wa * 0.01;
c_dr_wa = mx_dr_wa * 0.01;
c_ve_wa = mx_ve_wa * 0.01;
c_mw_wa = mx_mw_wa * 0.01;
c_vo_wa = mx_vo_wa * 0.01;
c_nb_wa = mx_nb_wa * 0.01;
c_ro_wa = mx_ro_wa * 0.01;
c_l1_dv = mx_l1_dv * 0.01;
c_l2_dv = mx_l2_dv * 0.01;
c_en_dv = mx_en_dv * 0.01;
c_dr_dv = mx_dr_dv * 0.01;
c_ve_dv = mx_ve_dv * 0.01;
c_mw_dv = mx_mw_dv * 0.01;
c_vo_dv = mx_vo_dv * 0.01;
c_nb_dv = mx_nb_dv * 0.01;
c_ro_dv = mx_ro_dv * 0.01;
c_l1_bc = mx_l1_bc * 0.01;
c_l2_bc = mx_l2_bc * 0.01;
c_en_bc = mx_en_bc * 0.01;
c_dr_bc = mx_dr_bc * 0.01;
c_ve_bc = mx_ve_bc * 0.01;
c_mw_bc = mx_mw_bc * 0.01;
c_vo_bc = mx_vo_bc * 0.01;
c_nb_bc = mx_nb_bc * 0.01;
c_ro_bc = mx_ro_bc * 0.01;
c_l1_bw = mx_l1_bw * 0.01;
c_l2_bw = mx_l2_bw * 0.01;
c_en_bw = mx_en_bw * 0.01;
c_dr_bw = mx_dr_bw * 0.01;
c_ve_bw = mx_ve_bw * 0.01;
c_mw_bw = mx_mw_bw * 0.01;
c_vo_bw = mx_vo_bw * 0.01;
c_nb_bw = mx_nb_bw * 0.01;
c_ro_bw = mx_ro_bw * 0.01;
c_l1_rf = mx_l1_rf * 0.01;
c_l2_rf = mx_l2_rf * 0.01;
c_en_rf = mx_en_rf * 0.01;
c_dr_rf = mx_dr_rf * 0.01;
c_ve_rf = mx_ve_rf * 0.01;
c_mw_rf = mx_mw_rf * 0.01;
c_vo_rf = mx_vo_rf * 0.01;
c_nb_rf = mx_nb_rf * 0.01;
c_ro_rf = mx_ro_rf * 0.01;
c_l1_rb = mx_l1_rb * 0.01;
c_l2_rb = mx_l2_rb * 0.01;
c_en_rb = mx_en_rb * 0.01;
c_dr_rb = mx_dr_rb * 0.01;
c_ve_rb = mx_ve_rb * 0.01;
c_mw_rb = mx_mw_rb * 0.01;
c_vo_rb = mx_vo_rb * 0.01;
c_nb_rb = mx_nb_rb * 0.01;
c_ro_rb = mx_ro_rb * 0.01;
c_l1_ou = mx_l1_ou * 0.01;
c_l2_ou = mx_l2_ou * 0.01;
c_en_ou = mx_en_ou * 0.01;
c_dr_ou = mx_dr_ou * 0.01;
c_ve_ou = mx_ve_ou * 0.01;
c_mw_ou = mx_mw_ou * 0.01;
c_vo_ou = mx_vo_ou * 0.01;
c_nb_ou = mx_nb_ou * 0.01;
c_ro_ou = mx_ro_ou * 0.01;
g_wp = c_en_wp * envs + c_ve_wp * vel + c_mw_wp * mw;
g_rp = c_en_rp * envs + c_ve_rp * vel + c_mw_rp * mw;
g_sz = c_en_sz * envs + c_ve_sz * vel + c_mw_sz * mw;
g_sy = c_en_sy * envs + c_ve_sy * vel + c_mw_sy * mw;
g_sp = c_en_sp * envs + c_ve_sp * vel + c_mw_sp * mw;
g_wa = c_en_wa * envs + c_ve_wa * vel + c_mw_wa * mw;
g_dv = c_en_dv * envs + c_ve_dv * vel + c_mw_dv * mw;
g_bc = c_en_bc * envs + c_ve_bc * vel + c_mw_bc * mw;
g_bw = c_en_bw * envs + c_ve_bw * vel + c_mw_bw * mw;
g_rf = c_en_rf * envs + c_ve_rf * vel + c_mw_rf * mw;
g_rb = c_en_rb * envs + c_ve_rb * vel + c_mw_rb * mw;
g_ou = c_en_ou * envs + c_ve_ou * vel + c_mw_ou * mw;

// ---- section switches (D17) and the limiter switch: 5 ms one-pole, snapped to exactly 0 / 1; at load
// they start at their stored state (no fade from the History defaults) ----
ksw = first ? 1 : 1 - exp(-1 / (0.005 * samplerate));
tdrv = drvon > 0.5;
tband = bandon > 0.5;
tres = reson > 0.5;
tlim = limon > 0.5;
xdrv = sdrv + (tdrv - sdrv) * ksw;
xband = sband + (tband - sband) * ksw;
xres = sres + (tres - sres) * ksw;
xlim = slim + (tlim - slim) * ksw;
wdrv = (abs(tdrv - xdrv) < 0.00001) ? tdrv : xdrv;
wband = (abs(tband - xband) < 0.00001) ? tband : xband;
wres = (abs(tres - xres) < 0.00001) ? tres : xres;
wlim = (abs(tlim - xlim) < 0.00001) ? tlim : xlim;

// ---- tone constants ----
nyq = 0.45 * samplerate;
rq = bres * 0.01;
s24 = bslope > 0.5;
rej = bmode > 0.5;
// SVF damping k = 1/Q: 24 dB = Butterworth stage (Q 0.5412) + resonant stage (Q 1.3066 .. 18);
// 12 dB = one resonant stage (Q 0.7071 .. 18).
kres = s24 ? 1 / (1.3066 * pow(18 / 1.3066, rq)) : 1 / (0.7071 * pow(18 / 0.7071, rq));
kst1 = s24 ? 1.8478 : kres;
fbk = rsfb * 0.01;
cmix = rsmix * 0.01;
rdel = cwi;

asymbase = wsym;
rsym = (rdir > 0.5) ? 0.5 : 1;        // read Tri: one way = rising ramp, both = triangle

sumL = 0;
sumR = 0;
for (v = 0; v < NV; v += 1) {
	pos = (v - (NV - 1) * 0.5) / ((NV - 1) * 0.5);   // -1..1 across the voices
	u = (pos + 1) * 0.5;                              // 0..1

	// ---- mod sources of this voice ----
	// LFO 1 / 2: per-voice rate spread up to +-half an octave, retrigger, phase offset (R3)
	lp1 = re1 > 0.5 ? 0 : peek(ph, v, 2, interp = "none", boundmode = "ignore");
	lp2 = re2 > 0.5 ? 0 : peek(ph, v, 3, interp = "none", boundmode = "ignore");
	n1 = lp1 + f1 * exp2(l1spread * 0.005 * pos) / samplerate;
	n2 = lp2 + f2 * exp2(l2spread * 0.005 * pos) / samplerate;
	w1 = n1 >= 1;
	w2 = n2 >= 1;
	r1p = peek(rnd, v, 0, interp = "none", boundmode = "ignore");
	r1n = peek(rnd, v, 1, interp = "none", boundmode = "ignore");
	r2p = peek(rnd, v, 2, interp = "none", boundmode = "ignore");
	r2n = peek(rnd, v, 3, interp = "none", boundmode = "ignore");
	// drift: slow smooth random, 0.07 .. 0.13 Hz per voice
	dp = peek(ph, v, 4, interp = "none", boundmode = "ignore");
	dn = dp + (0.07 + 0.015 * v) / samplerate;
	wd = dn >= 1;
	rdp = peek(rnd, v, 4, interp = "none", boundmode = "ignore");
	rdn = peek(rnd, v, 5, interp = "none", boundmode = "ignore");
	seed = peek(rnd, v, 6, interp = "none", boundmode = "ignore");
	// new random values at each cycle wrap (the seed is stepped below, after the write pointer)
	sa = lcg(seed);
	sb = lcg(sa);
	sc = lcg(sb);
	r1pn = w1 ? r1n : r1p;
	r1nn = w1 ? sa / 2147483647 * 2 - 1 : r1n;
	r2pn = w2 ? r2n : r2p;
	r2nn = w2 ? sb / 2147483647 * 2 - 1 : r2n;
	rdpn = wd ? rdn : rdp;
	rdnn = wd ? sc / 2147483647 * 2 - 1 : rdn;
	poke(rnd, r1pn, v, 0, 0);
	poke(rnd, r1nn, v, 1, 0);
	poke(rnd, r2pn, v, 2, 0);
	poke(rnd, r2nn, v, 3, 0);
	poke(rnd, rdpn, v, 4, 0);
	poke(rnd, rdnn, v, 5, 0);
	nlp1 = wrap(n1, 0, 1);
	nlp2 = wrap(n2, 0, 1);
	ndp = wrap(dn, 0, 1);
	poke(ph, nlp1, v, 2, 0);
	poke(ph, nlp2, v, 3, 0);
	poke(ph, ndp, v, 4, 0);
	lv1 = lfoshape(wrap(lp1 + po1, 0, 1), l1shape, r1p, r1n);
	lv2 = lfoshape(wrap(lp2 + po2, 0, 1), l2shape, r2p, r2n);
	drv = rdp + (rdn - rdp) * (0.5 - 0.5 * cos(pi * dp));

	// Voice / Neighbour (D12): raw core signals of the previous sample. Read Osc (D13): the naive read
	// shape from the stored (not yet advanced) read phase, bipolar.
	yv = peek(yfb, v, 0, interp = "none", boundmode = "ignore");
	yn = peek(yfb, wrap(v + 1, 0, NV), 0, interp = "none", boundmode = "ignore");
	phw = wrs ? 0 : peek(ph, v, 0, interp = "none", boundmode = "ignore");
	phr = rrs ? 0 : peek(ph, v, 1, interp = "none", boundmode = "ignore");
	trir = skewtri(phr, rsym);
	ro = 2 * ((rshape > 0.5) ? trir : phr) - 1;

	// target sums of the matrix (units: docs/v0.3-design.md D26)
	m_wp = g_wp + c_l1_wp * lv1 + c_l2_wp * lv2 + c_dr_wp * drv + c_vo_wp * yv + c_nb_wp * yn + c_ro_wp * ro;
	m_rp = g_rp + c_l1_rp * lv1 + c_l2_rp * lv2 + c_dr_rp * drv + c_vo_rp * yv + c_nb_rp * yn + c_ro_rp * ro;
	m_sz = g_sz + c_l1_sz * lv1 + c_l2_sz * lv2 + c_dr_sz * drv + c_vo_sz * yv + c_nb_sz * yn + c_ro_sz * ro;
	m_sy = g_sy + c_l1_sy * lv1 + c_l2_sy * lv2 + c_dr_sy * drv + c_vo_sy * yv + c_nb_sy * yn + c_ro_sy * ro;
	m_sp = g_sp + c_l1_sp * lv1 + c_l2_sp * lv2 + c_dr_sp * drv + c_vo_sp * yv + c_nb_sp * yn + c_ro_sp * ro;
	m_wa = g_wa + c_l1_wa * lv1 + c_l2_wa * lv2 + c_dr_wa * drv + c_vo_wa * yv + c_nb_wa * yn + c_ro_wa * ro;
	m_dv = g_dv + c_l1_dv * lv1 + c_l2_dv * lv2 + c_dr_dv * drv + c_vo_dv * yv + c_nb_dv * yn + c_ro_dv * ro;
	m_bc = g_bc + c_l1_bc * lv1 + c_l2_bc * lv2 + c_dr_bc * drv + c_vo_bc * yv + c_nb_bc * yn + c_ro_bc * ro;
	m_bw = g_bw + c_l1_bw * lv1 + c_l2_bw * lv2 + c_dr_bw * drv + c_vo_bw * yv + c_nb_bw * yn + c_ro_bw * ro;
	m_rf = g_rf + c_l1_rf * lv1 + c_l2_rf * lv2 + c_dr_rf * drv + c_vo_rf * yv + c_nb_rf * yn + c_ro_rf * ro;
	m_rb = g_rb + c_l1_rb * lv1 + c_l2_rb * lv2 + c_dr_rb * drv + c_vo_rb * yv + c_nb_rb * yn + c_ro_rb * ro;
	m_ou = g_ou + c_l1_ou * lv1 + c_l2_ou * lv2 + c_dr_ou * drv + c_vo_ou * yv + c_nb_ou * yn + c_ro_ou * ro;

	// ---- pointers ----
	// read spread (V - 0.5)/Vcs - 0.5 semitones with V = v + 1; Read Spread target adds +-6 st
	noter = pr + (rspread + 6 * m_sp) * ((v + 0.5) / NV - 0.5) + m_rp;
	notew = pw + m_wp;
	fw = mtof(notew);
	fr = mtof(noter);
	incw = fw / samplerate;
	incr = fr / samplerate;
	nphw = wrap(phw + incw, 0, 1);
	nphr = wrap(phr + incr, 0, 1);
	poke(ph, nphw, v, 0, 0);
	poke(ph, nphr, v, 1, 0);

	// Noise write shape (D4, D29): a new random position at each write-cycle wrap. The generator
	// steps once whenever LFO 1, LFO 2, Drift or the write pointer wraps.
	ww = (phw + incw) >= 1;
	sd = lcg(sc);
	nseed = (w1 + w2 + wd + ww > 0.5) ? sd : seed;
	poke(rnd, nseed, v, 6, 0);
	nzp = peek(rnd, v, 7, interp = "none", boundmode = "ignore");
	nzn = peek(rnd, v, 8, interp = "none", boundmode = "ignore");
	nzpn = ww ? nzn : nzp;
	nznn = ww ? sd / 2147483647 : nzn;
	poke(rnd, nzpn, v, 7, 0);
	poke(rnd, nznn, v, 8, 0);

	// shapes; the anti-aliased ramp may leave 0..1 slightly, positions and values are clipped (C4)
	bw = blep(phw, incw);
	br = blep(phr, incr);
	rampw = (aaramp > 0.5) ? phw - 0.5 * bw : phw;
	rampr = (aaramp > 0.5) ? phr - 0.5 * br : phr;
	rd = (rshape > 0.5) ? trir : rampr;              // read phase = written data
	symw = clamp(asymbase + m_sy, -1, 1);
	sa1 = (1 + symw) * 0.5;                          // 0..1: skew peak, pulse width, duty (D6)
	// 0 Ramp: curve p^(4^-s)
	xr0 = pow(clamp(rampw, 0, 1), exp2(-2 * symw));
	// 1 Tri (0..1), 2 Tri +- (the original's -1..1, negative half clipped to cell 0, R22)
	triw = skewtri(phw, sa1);
	tripm = 2 * triw - 1;
	// 3 Sine, the phase warped so that the peak sits at sa1
	qa = 0.5 * phw / max(sa1, 1e-9);
	qb = 0.5 + 0.5 * (phw - sa1) / max(1 - sa1, 1e-9);
	sinw = 0.5 - 0.5 * cos(twopi * ((phw < sa1) ? qa : qb));
	// 4 Pulse: two cells (start and end of the span), Width
	pulw = phw >= clamp(sa1, 0.01, 0.99);
	// 5 Pulsar: sweep within Duty, then rest; 6 Spike: up and back within Width, then rest (D29)
	dut = clamp(sa1, 0.02, 1);
	plsw = clamp(phw / dut, 0, 1);
	spkw = clamp(1 - abs(2 * phw / dut - 1), 0, 1);
	inburst = phw < dut;
	// 7 Noise: stepped (Smooth -1) .. cosine-smooth (+1) between two random points
	nzw = nzp + (nzn - nzp) * (0.5 - 0.5 * cos(pi * phw)) * sa1;
	shp = floor(wshape + 0.5);
	xs = (shp < 0.5) ? xr0 : ((shp < 1.5) ? triw : ((shp < 2.5) ? tripm : ((shp < 3.5) ? sinw
		: ((shp < 4.5) ? pulw : ((shp < 5.5) ? plsw : ((shp < 6.5) ? spkw : nzw))))));
	rest = (shp > 4.5) * (shp < 6.5) * (1 - inburst) * (1 - wclean);
	xw = wclean ? rd : xs;                           // Clean = the original's "=read" (D5)
	sz = clamp(size * exp2(3 * m_sz), 0.001, 1);     // Size target: +-3 octaves
	wpos = xw * sz;
	rpos = rd * gon * sz;                            // 0 while the gate is closed (original: RX = phi*G*size)

	// Write state (D5) and Write target with hysteresis (D15): base 1 in Write / Clean, 0 in Freeze
	wfl = peek(ph, v, 5, interp = "none", boundmode = "ignore");
	wv = wbase + m_wa;
	nwfl = (wfl > 0.5) ? (wv > 0.48) : (wv > 0.52);
	poke(ph, nwfl, v, 5, 0);
	wen = gon * nwfl * (1 - rest);

	// Same-sample order: WRITE first, then READ (statement order is the order in GenExpr).
	// Index floor, clipped to the row like the original's Audio Table (C4: Clip); values clipped to 0..1.
	wi = clamp(floor(wpos * N), 0, N - 1);
	wval = clamp(rd, 0, 1);
	if (wen > 0.5) {
		poke(atab, wval, wi, v, 0);
	}
	ri = rpos * N;
	i0 = clamp(floor(ri), 0, N - 1);
	frac = clamp(ri - i0, 0, 1);
	a0 = peek(atab, i0, v, interp = "none", boundmode = "ignore");
	a1 = peek(atab, wrap(i0 + 1, 0, N), v, interp = "none", boundmode = "ignore");
	val = (smoothread > 0.5) ? a0 + (a1 - a0) * frac : a0;
	y = 2 * val - 1;
	poke(yfb, y, v, 1, 0);                           // Voice / Neighbour sources, next sample

	// ---- Drive (R18): tanh, normalised so +-1 stays +-1; faded in over the first 2 dB ----
	drd = clamp(drive + 24 * m_dv, 0, 24);           // Drive target: +-24 dB
	dg = dbtoa(drd);
	ydr = y + clamp(drd * 0.5, 0, 1) * (tanh(y * dg) / tanh(dg) - y);
	yd = y + wdrv * (ydr - y);                       // section switch (D17)

	// ---- Band (R16, R17): lower edge filter A, upper edge filter B, TPT SVFs (Zavalishin) ----
	cen0 = bcenter * exp2(bspread * 0.02 * pos + 4 * m_bc);
	cen = cen0 * exp2(bfm * 0.04 * y);               // audio-rate FM from the unfiltered core
	wid = clamp(bwidth + 5 * m_bw, 0.2, 10);
	flo = clamp(cen * exp2(-0.5 * wid), 10, nyq);
	fhi = clamp(cen * exp2(0.5 * wid), 10, nyq);
	ga = tan(pi * flo / samplerate);
	gb = tan(pi * fhi / samplerate);
	// coefficients: stage 1 (k = kst1), stage 2 (k = kres)
	aa1 = 1 / (1 + ga * (ga + kst1));
	aa2 = ga * aa1;
	aa3 = ga * aa2;
	ab1 = 1 / (1 + ga * (ga + kres));
	ab2 = ga * ab1;
	ab3 = ga * ab2;
	ba1 = 1 / (1 + gb * (gb + kst1));
	ba2 = gb * ba1;
	ba3 = gb * ba2;
	bb1 = 1 / (1 + gb * (gb + kres));
	bb2 = gb * bb1;
	bb3 = gb * bb2;
	// filter A stage 1 (input yd): Pass uses its HP, Reject its LP
	sA1 = peek(flt, v, 0, interp = "none", boundmode = "ignore");
	sA2 = peek(flt, v, 1, interp = "none", boundmode = "ignore");
	x3 = yd - sA2;
	x1 = aa1 * sA1 + aa2 * x3;
	x2 = sA2 + aa2 * sA1 + aa3 * x3;
	nA1 = fixdenorm(2 * x1 - sA1);
	nA2 = fixdenorm(2 * x2 - sA2);
	oA1 = rej ? x2 : yd - kst1 * x1 - x2;
	poke(flt, nA1, v, 0, 0);
	poke(flt, nA2, v, 1, 0);
	// filter A stage 2
	sB1 = peek(flt, v, 2, interp = "none", boundmode = "ignore");
	sB2 = peek(flt, v, 3, interp = "none", boundmode = "ignore");
	x3 = oA1 - sB2;
	x1 = ab1 * sB1 + ab2 * x3;
	x2 = sB2 + ab2 * sB1 + ab3 * x3;
	nB1 = fixdenorm(2 * x1 - sB1);
	nB2 = fixdenorm(2 * x2 - sB2);
	oA2 = rej ? x2 : oA1 - kres * x1 - x2;
	poke(flt, nB1, v, 2, 0);
	poke(flt, nB2, v, 3, 0);
	outA = s24 ? oA2 : oA1;
	// filter B: Pass = LP of filter A's output, Reject = HP of the driven signal (parallel)
	inB = rej ? yd : outA;
	sC1 = peek(flt, v, 4, interp = "none", boundmode = "ignore");
	sC2 = peek(flt, v, 5, interp = "none", boundmode = "ignore");
	x3 = inB - sC2;
	x1 = ba1 * sC1 + ba2 * x3;
	x2 = sC2 + ba2 * sC1 + ba3 * x3;
	nC1 = fixdenorm(2 * x1 - sC1);
	nC2 = fixdenorm(2 * x2 - sC2);
	oB1 = rej ? inB - kst1 * x1 - x2 : x2;
	poke(flt, nC1, v, 4, 0);
	poke(flt, nC2, v, 5, 0);
	sD1 = peek(flt, v, 6, interp = "none", boundmode = "ignore");
	sD2 = peek(flt, v, 7, interp = "none", boundmode = "ignore");
	x3 = oB1 - sD2;
	x1 = bb1 * sD1 + bb2 * x3;
	x2 = sD2 + bb2 * sD1 + bb3 * x3;
	nD1 = fixdenorm(2 * x1 - sD1);
	nD2 = fixdenorm(2 * x2 - sD2);
	oB2 = rej ? oB1 - kres * x1 - x2 : x2;
	poke(flt, nD1, v, 6, 0);
	poke(flt, nD2, v, 7, 0);
	outB = s24 ? oB2 : oB1;
	bnd = rej ? outA + outB : outB;
	band = yd + wband * (bnd - yd);                  // section switch (D17); filters keep running

	// ---- Resonator (R18): feedback comb, + peaks / - notches, output power-normalised ----
	rsf = clamp(((rstrack > 0.5) ? fr : rsfreq) * exp2(3 * m_rf), 20, 5000);
	dl = samplerate / rsf;
	rp = wrap(rdel - dl, 0, CB);
	j0 = floor(rp);
	fj = rp - j0;
	c0 = peek(cbuf, j0, v, interp = "none", boundmode = "ignore");
	c1 = peek(cbuf, wrap(j0 + 1, 0, CB), v, interp = "none", boundmode = "ignore");
	fbv = clamp(fbk + 0.95 * m_rb, -0.95, 0.95);     // Res Fdbk target: +-95 %
	ycomb = band + fbv * (c0 + (c1 - c0) * fj);
	cw = fixdenorm(ycomb);
	poke(cbuf, cw, rdel, v, 0);
	vres = band + cmix * (ycomb * sqrt(1 - fbv * fbv) - band);
	vo = band + wres * (vres - band);                // section switch (D17); the comb keeps running

	// ---- level, pan, sum ----
	gv = dbtoa(clamp(24 * m_ou, -60, 12));           // Output target: +-24 dB (max +12)
	pan = clamp(width * pos, -1, 1);                 // equal-power pan
	ang = (pan + 1) * pi * 0.25;
	sumL += vo * gv * cos(ang);
	sumR += vo * gv * sin(ang);

	// ---- display data ----
	poke(aheads, wi / N, v, 0, 0);
	poke(aheads, clamp(rpos, 0, 1), v, 1, 0);
	poke(aheads, wen, v, 2, 0);
	poke(aheads, sz, v, 3, 0);
	poke(aheads, fw, v, 4, 0);
	poke(aheads, fr, v, 5, 0);
	poke(aheads, cen0, v, 6, 0);
	poke(aheads, wid, v, 7, 0);
	poke(aheads, rsf, v, 8, 0);
}
// Voice / Neighbour: this sample's core signals become the previous ones for the next sample
for (v = 0; v < NV; v += 1) {
	ycur = peek(yfb, v, 1, interp = "none", boundmode = "ignore");
	poke(yfb, ycur, v, 0, 0);
}
poke(aheads, samplerate, 0, 9, 0);
poke(aheads, env, 2, 9, 0);
poke(aheads, 60 * bhz, 3, 9, 0);
poke(aheads, isplay, 4, 9, 0);

smw = pw;
smr = pr;
smgain = g;
smvel = vel;
smmw = mw;
genv = env;
sdrv = wdrv;
sband = wband;
sres = wres;
slim = wlim;
prevgate = gon;
prevsync = syn;
prevnote = non;
prevplay = isplay;
prevbar = in4;
barcount = bc;
cwi = wrap(cwi + 1, 0, CB);
inited = 1;

// Output, DC blocker (5 Hz one-pole high-pass, always on)
outl = sumL * g * env;
outr = sumR * g * env;
dcr = 1 - twopi * 5 / samplerate;
hl = outl - dcxl + dcr * dcyl;
hr = outr - dcxr + dcr * dcyr;
dcxl = outl;
dcyl = fixdenorm(hl);
dcxr = outr;
dcyr = fixdenorm(hr);

// Envelope follower (D16, D27): peak of the sum before the limiter, separate attack / release;
// the voices read the source value in the next sample (every use is a feedback loop).
ein = max(abs(hl), abs(hr));
kea = 1 - exp(-1 / (enatt * 0.001 * samplerate));
ker = 1 - exp(-1 / (enrel * 0.001 * samplerate));
nenv = fixdenorm(envf + (ein - envf) * ((ein > envf) ? kea : ker));
envf = nenv;
envs = clamp(nenv * dbtoa(engain), 0, 1);

// Color limiter (D19, D28), stereo-linked, zero latency: Gain -> colour pre-emphasis (one-pole split
// at 700 Hz, lows x glo, highs x ghi) -> saturation -> only the saturation residual is de-emphasised
// (so Color alone changes nothing and Saturation 0 is an exact bypass) -> peak limiter with instant
// attack and a release one-pole; the output never exceeds the ceiling. Off = exact bypass (D17 switch).
lgi = dbtoa(limgain);
xl = hl * lgi;
xr = hr * lgi;
kc = 1 - exp(-twopi * 700 / samplerate);
glo = dbtoa(-0.09 * limcolor);
ghi = dbtoa(0.09 * limcolor);
ss = limsat * 0.01;
ks = 1 + 4 * ss;
tks = tanh(ks);
nl1 = lpl1 + (xl - lpl1) * kc;
nr1 = lpr1 + (xr - lpr1) * kc;
pel = glo * nl1 + ghi * (xl - nl1);
per = glo * nr1 + ghi * (xr - nr1);
rsl = ss * (tanh(ks * pel) / tks - pel);
rsr = ss * (tanh(ks * per) / tks - per);
nl2 = lpl2 + (rsl - lpl2) * kc;
nr2 = lpr2 + (rsr - lpr2) * kc;
ql = xl + nl2 / glo + (rsl - nl2) / ghi;
qr = xr + nr2 / glo + (rsr - nr2) / ghi;
lpl1 = fixdenorm(nl1);
lpr1 = fixdenorm(nr1);
lpl2 = fixdenorm(nl2);
lpr2 = fixdenorm(nr2);
lpk = max(abs(ql), abs(qr));
ltg = min(1, dbtoa(limceil) / max(lpk, 1e-9));
klr = 1 - exp(-1 / (limrel * 0.001 * samplerate));
nlg = (ltg < limg) ? ltg : limg + (ltg - limg) * klr;
limg = nlg;
yl = hl + wlim * (ql * nlg - hl);
yr = hr + wlim * (qr * nlg - hr);

// Safety stage (development builds): no NaN/inf/denormals, hard clip to -1..1.
out1 = clip(fixdenorm(fixnan(yl)), -1, 1);
out2 = clip(fixdenorm(fixnan(yr)), -1, 1);
out3 = envs;

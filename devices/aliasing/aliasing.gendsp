{
 "patcher": {
  "fileversion": 1,
  "appversion": {
   "major": 9,
   "minor": 1,
   "revision": 4,
   "architecture": "x64",
   "modernui": 1
  },
  "classnamespace": "dsp.gen",
  "rect": [
   100.0,
   100.0,
   660.0,
   540.0
  ],
  "boxes": [
   {
    "box": {
     "code": "// aliasing.genexpr - v0.2 DSP of the Aliasing device (devices/aliasing).\r\n// Source of truth for aliasing.gendsp (generated by tools/check.sh; never edit the .gendsp).\r\n// Design: docs/port-decisions.md (Q1-Q9, Q15), docs/redesign-t1.md (R1-R4, R16-R24) and the build\r\n// notes with every own decision in docs/v0.2-build.md.\r\n//\r\n// Mechanism (unchanged from v0.1): per voice a write pointer and a read pointer run at their own\r\n// rates. The read phase (0..1) is written into the voice's table row at the write position, then\r\n// the row is read at the read position; the core signal is 2v - 1. Pointers are naive by default\r\n// (the errors are the sound); an anti-aliased ramp is an option (R24).\r\n// Per voice after the core: Drive -> Band (coupled HP + LP, FM from the core) -> Resonator (comb)\r\n// -> pan. Then sum, Output, DC blocker, optional soft clip, safety stage.\r\n//\r\n// Inlets   in1  MIDI gate (signal, 1 while any note is held)\r\n//          in2  Sync impulse (click~ from the Sync button): restarts both pointers\r\n//          in3  note-on impulse (click~ on every note-on): LFO retrigger \"Note\"; in MIDI gate mode\r\n//               it also restarts both pointers (R1)\r\n//          in4  bar ramp (phasor~ 1.0.0 @lock 1: 0..1 per bar while Live's transport runs)\r\n// Outlets  out1, out2  stereo, after the safety stage\r\n// Buffers  atab    bound by the shell: gen~ @atab ---atab    (5 ch x 1024 samples, float32);\r\n//                  channel = voice, the table that the DSP and the v8ui display share\r\n//          aheads  bound by the shell: gen~ @aheads ---aheads (10 ch x 5 samples), display data per\r\n//                  voice (sample = voice): ch 0 write head, ch 1 read head (0..1 of the row), ch 2 write\r\n//                  enable, ch 3 effective Size, ch 4 write Hz, ch 5 read Hz, ch 6 band centre Hz\r\n//                  (without FM), ch 7 band width in octaves, ch 8 resonator Hz; ch 9 globals:\r\n//                  sample 0 samplerate, sample 1 table-valid flag (written by the display script when\r\n//                  it restores a stored table; read here once at load), sample 2 gate envelope,\r\n//                  sample 3 tempo in BPM, sample 4 transport playing\r\n// The default buffer names are placeholders: without the shell's attributes nothing is heard.\r\n\r\n// Asymmetric triangle 0..1..0 over one phase p in [0, 1), peak at p = a.\r\n// a = 1: rising ramp, a = 0.5: triangle, a = 0: falling ramp.\r\n// Branch-free on purpose (no ?:, no if): Max 9.1.x fails on user functions with a branch inside a\r\n// poke value (gen-pitfalls, gen2.dsp.Model:1455); results are put into variables before any poke.\r\nskewtri(p, a) {\r\n\tup = p / max(a, 1e-9) + (a < 1e-9);\r\n\tdown = (1 - p) / max(1 - a, 1e-9);\r\n\treturn min(up, down);\r\n}\r\n\r\n// PolyBLEP residual of a 0..1 ramp at phase p with phase increment dt (R24). dt is clamped to 0.5:\r\n// above fs/2 the pointer aliases anyway and the correction only has to stay finite. Branch-free.\r\nblep(p, dt) {\r\n\tbd = clamp(dt, 1e-9, 0.5);\r\n\tbt1 = p / bd;\r\n\tbt2 = (p - 1) / bd;\r\n\tba = (p < bd) * (bt1 + bt1 - bt1 * bt1 - 1);\r\n\tbb = (p > 1 - bd) * (bt2 * bt2 + bt2 + bt2 + 1);\r\n\treturn ba + bb;\r\n}\r\n\r\n// Park-Miller step on an integer seed held in a double (exact: 16807 * 2^31 < 2^53).\r\nlcg(s) {\r\n\treturn (s * 16807) % 2147483647;\r\n}\r\n\r\n// LFO shapes on phase p (0..1), bipolar -1..1. sh: 0 sine, 1 triangle, 2 saw, 3 square,\r\n// 4 sample and hold (rb = value of this cycle), 5 smooth random (ra -> rb over the cycle).\r\nlfoshape(p, sh, ra, rb) {\r\n\tls0 = sin(twopi * p);\r\n\tls1 = 1 - 4 * abs(wrap(p + 0.25, 0, 1) - 0.5);\r\n\tls2 = 2 * p - 1;\r\n\tls3 = 1 - 2 * (p >= 0.5);\r\n\tls5 = ra + (rb - ra) * (0.5 - 0.5 * cos(pi * p));\r\n\treturn (sh < 0.5) * ls0 + (sh >= 0.5) * (sh < 1.5) * ls1 + (sh >= 1.5) * (sh < 2.5) * ls2\r\n\t\t+ (sh >= 2.5) * (sh < 3.5) * ls3 + (sh >= 3.5) * (sh < 4.5) * rb + (sh >= 4.5) * ls5;\r\n}\r\n\r\n// ---- Parameters (names = the shell's \"prepend <name>\" messages) ----\r\n// Defaults = init state (R21): write 71 + 0.217 st = 16004 Hz = fs/3 + 4 Hz at 48 kHz, write Tri,\r\n// read -30 st, spread 2, Size 0.1: the aliasing regime of the original (table-behaviour.md).\r\n// Global / Out page\r\nParam gatemode(0, min = 0, max = 1);      // R1: 0 Drone, 1 MIDI\r\nParam resync(0, min = 0, max = 4);        // R2: Off, 1, 2, 4, 8 bars\r\nParam transpose(0, min = -12, max = 12);\r\nParam width(1, min = 0, max = 2);\r\nParam output(-6, min = -36, max = 0);\r\nParam softclip(1, min = 0, max = 1);      // R18: Clip\r\nParam aaramp(0, min = 0, max = 1);        // R24: anti-aliased ramps for both pointers\r\nParam size(0.1, min = 0.001, max = 1);\r\n// Host and MIDI state, set by the shell (not Live parameters)\r\nParam playing(0, min = 0, max = 1);       // plugsync~ transport state\r\nParam spb(0, min = 0, max = 1000000);     // plugsync~ samples per beat (0 = unknown -> 120 BPM)\r\nParam velocity(0, min = 0, max = 1);      // last note-on velocity / 127\r\nParam modwheel(0, min = 0, max = 1);      // CC 1 / 127\r\n// Write pointer\r\nParam wmode(0, min = 0, max = 1);         // R2: 0 Free, 1 Sync\r\nParam wpitch(71, min = -64, max = 130);   // R20: above ~fs/2 the pattern depends on fs\r\nParam wnote(13, min = 0, max = 18);        // note value index (divb below)\r\nParam wmult(1, min = 1, max = 64);\r\nParam wfine(0.217, min = -1, max = 1);    // Free: fine; Sync: detune against the grid\r\nParam wsym(0, min = -1, max = 1);\r\nParam wshape(1, min = 0, max = 3);        // Ramp, Tri, Tri +- (R22), =Read\r\nParam wactive(1, min = 0, max = 1);\r\n// Read pointer\r\nParam rmode(0, min = 0, max = 1);\r\nParam rpitch(-30, min = -64, max = 64);\r\nParam rnote(13, min = 0, max = 18);\r\nParam rmult(1, min = 1, max = 64);\r\nParam rfine(0, min = -1, max = 1);\r\nParam rspread(2, min = 0, max = 6);\r\nParam rshape(0, min = 0, max = 1);        // Ramp, Tri\r\nParam rdir(0, min = 0, max = 1);          // Tri: one way (rising) or both\r\nParam smoothread(0, min = 0, max = 1);\r\n// LFOs (R3)\r\nParam l1mode(0, min = 0, max = 1);\r\nParam l1rate(0.15, min = 0.01, max = 20);\r\nParam l1note(7, min = 0, max = 18);\r\nParam l1phase(0, min = 0, max = 360);\r\nParam l1spread(50, min = 0, max = 100);\r\nParam l1shape(0, min = 0, max = 5);\r\nParam l1retrig(0, min = 0, max = 2);      // Off, Note, Bar\r\nParam l2mode(1, min = 0, max = 1);\r\nParam l2rate(0.07, min = 0.01, max = 20);\r\nParam l2note(3, min = 0, max = 18);\r\nParam l2phase(90, min = 0, max = 360);\r\nParam l2spread(50, min = 0, max = 100);\r\nParam l2shape(5, min = 0, max = 5);\r\nParam l2retrig(2, min = 0, max = 2);\r\n// Mod slots (R4). Sources: 0 none, 1 LFO 1, 2 LFO 2, 3 Drift, 4 Velocity, 5 Mod Wheel.\r\n// Targets: 0 none, 1 Write Pitch, 2 Read Pitch, 3 Size, 4 Write Sym, 5 Read Spread,\r\n// 6 Band Center, 7 Band Width, 8 Res Freq, 9 Width, 10 Output. Depth in percent.\r\nParam m1src(1, min = 0, max = 5);\r\nParam m1tgt(1, min = 0, max = 10);\r\nParam m1depth(0, min = -100, max = 100);\r\nParam m2src(2, min = 0, max = 5);\r\nParam m2tgt(2, min = 0, max = 10);\r\nParam m2depth(0, min = -100, max = 100);\r\nParam m3src(0, min = 0, max = 5);\r\nParam m3tgt(0, min = 0, max = 10);\r\nParam m3depth(0, min = -100, max = 100);\r\nParam m4src(0, min = 0, max = 5);\r\nParam m4tgt(0, min = 0, max = 10);\r\nParam m4depth(0, min = -100, max = 100);\r\n// Tone (R16-R18)\r\nParam drive(0, min = 0, max = 24);           // dB\r\nParam bcenter(632, min = 20, max = 20000);   // Hz\r\nParam bwidth(10, min = 0.2, max = 10);       // octaves; 10 = open\r\nParam bres(0, min = 0, max = 100);           // percent\r\nParam bfm(0, min = 0, max = 100);            // percent: 100 = +-4 octaves per unit of core signal\r\nParam bspread(25, min = 0, max = 100);       // percent: 100 = centres +-2 octaves across the voices\r\nParam bslope(1, min = 0, max = 1);           // 12 dB, 24 dB\r\nParam bmode(0, min = 0, max = 1);            // Pass, Reject\r\nParam rsfreq(140, min = 20, max = 5000);     // Hz (fixed mode)\r\nParam rsfb(50, min = -95, max = 95);         // percent: + peaks, - notches\r\nParam rsmix(0, min = 0, max = 100);          // percent: 0 = bypass\r\nParam rstrack(1, min = 0, max = 1);          // follow the voice's read pointer frequency\r\n\r\nBuffer atab(\"aliasing_atab_unbound\");\r\nBuffer aheads(\"aliasing_aheads_unbound\");\r\n// Per voice (sample = voice, 64-bit, Q4): ch 0 write phase, 1 read phase, 2 LFO 1 phase,\r\n// 3 LFO 2 phase, 4 drift phase.\r\nData ph(8, 5);\r\n// Per voice random state: ch 0/1 LFO 1 previous/next, 2/3 LFO 2, 4/5 drift, 6 seed.\r\nData rnd(8, 7);\r\n// Per voice filter states: 4 SVF stages x 2 (A1, A2 = lower edge, B1, B2 = upper edge).\r\nData flt(8, 8);\r\n// Resonator delay lines, one channel per voice (16384 samples: 20 Hz down to 327 kHz).\r\nData cbuf(16384, 5);\r\n// Note values in quarter-note beats (bars = 4/4).\r\nData divb(19, 1);\r\nHistory inited(0);\r\nHistory prevgate(0);\r\nHistory prevsync(0);\r\nHistory prevnote(0);\r\nHistory prevplay(0);\r\nHistory prevbar(0);\r\nHistory barcount(0);\r\nHistory smw(0);\r\nHistory smr(0);\r\nHistory smgain(0);\r\nHistory smvel(0);\r\nHistory smmw(0);\r\nHistory genv(0);\r\nHistory cwi(0);\r\nHistory dcxl(0);\r\nHistory dcyl(0);\r\nHistory dcxr(0);\r\nHistory dcyr(0);\r\n\r\nNV = 5;      // NVOICES (Q7); the voice formulas below derive from it\r\nN = 1024;    // table cells per voice row (Q6)\r\nCB = 16384;  // resonator delay line length\r\nc = 0;\r\ni = 0;\r\nv = 0;\r\nfirst = inited < 0.5;\r\n\r\n// ---- one-time init (load / recompile) ----\r\n// Identity table T(x) = x per row (Q15), unless the display script has already restored a stored\r\n// table (flag in aheads ch 9 sample 1, R10).\r\nif (first) {\r\n\tif (peek(aheads, 1, 9, interp = \"none\", boundmode = \"ignore\") < 0.5) {\r\n\t\tfor (c = 0; c < NV; c += 1) {\r\n\t\t\tfor (i = 0; i < N; i += 1) {\r\n\t\t\t\tpoke(atab, i / N, i, c, 0);\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tpoke(divb, 32, 0, 0, 0);\r\n\tpoke(divb, 16, 1, 0, 0);\r\n\tpoke(divb, 8, 2, 0, 0);\r\n\tpoke(divb, 4, 3, 0, 0);\r\n\tpoke(divb, 2, 4, 0, 0);\r\n\tpoke(divb, 3, 5, 0, 0);\r\n\tpoke(divb, 4 / 3, 6, 0, 0);\r\n\tpoke(divb, 1, 7, 0, 0);\r\n\tpoke(divb, 1.5, 8, 0, 0);\r\n\tpoke(divb, 2 / 3, 9, 0, 0);\r\n\tpoke(divb, 0.5, 10, 0, 0);\r\n\tpoke(divb, 0.75, 11, 0, 0);\r\n\tpoke(divb, 1 / 3, 12, 0, 0);\r\n\tpoke(divb, 0.25, 13, 0, 0);\r\n\tpoke(divb, 0.375, 14, 0, 0);\r\n\tpoke(divb, 1 / 6, 15, 0, 0);\r\n\tpoke(divb, 0.125, 16, 0, 0);\r\n\tpoke(divb, 1 / 12, 17, 0, 0);\r\n\tpoke(divb, 0.0625, 18, 0, 0);\r\n\tfor (v = 0; v < NV; v += 1) {\r\n\t\tpoke(rnd, 1000 + 7919 * (v + 1), v, 6, 0);\r\n\t}\r\n}\r\n\r\n// ---- gate, restarts, transport ----\r\ngon = (gatemode > 0.5) ? (in1 > 0.5) : 1;          // R1: Drone always on, MIDI while a note is held\r\nsyn = in2 > 0.5;\r\nnon = in3 > 0.5;\r\nsyncedge = syn > prevsync;\r\nnoteedge = non > prevnote;\r\n// Restart of both pointers: load, Sync button, note-on in MIDI mode (R1)\r\nrsall = max(max(first, syncedge), noteedge * (gatemode > 0.5));\r\n// Transport: start (playing 0 -> 1) and bar wraps of the locked bar ramp\r\nisplay = playing > 0.5;\r\ntstart = isplay * (prevplay < 0.5);\r\nbarwrap = isplay * (in4 < prevbar - 0.5);\r\nbc = tstart ? 0 : barcount + barwrap;\r\nnres = (resync < 0.5) ? 0 : ((resync < 1.5) ? 1 : ((resync < 2.5) ? 2 : ((resync < 3.5) ? 4 : 8)));\r\nrsbar = barwrap * (nres > 0) * ((bc % max(nres, 1)) < 0.5);\r\n// Restart of synced pointers only: transport start and the Resync bars (R2)\r\nrssync = max(tstart, rsbar);\r\nwrs = max(rsall, rssync * (wmode > 0.5));\r\nrrs = max(rsall, rssync * (rmode > 0.5));\r\nlbar = max(tstart, barwrap);                        // LFO retrigger \"Bar\"\r\nwe = gon * (wactive > 0.5);\r\n\r\n// Tempo: beats per second from plugsync~ (samples per beat); 120 BPM until Live reports one.\r\nspbv = (spb > 1) ? spb : samplerate * 0.5;\r\nbhz = samplerate / spbv;\r\n\r\n// ---- pointer pitches, smoothed (~15 ms, Q5); snap on load and on the Sync button ----\r\nk = 1 - exp(-1 / (0.015 * samplerate));\r\nsnap = max(first, syncedge);\r\ndbw = peek(divb, clamp(floor(wnote + 0.5), 0, 18), 0, interp = \"none\", boundmode = \"ignore\");\r\ndbr = peek(divb, clamp(floor(rnote + 0.5), 0, 18), 0, interp = \"none\", boundmode = \"ignore\");\r\n// Sync: multiplier x note value at the current tempo, Fine = detune (R2); Free: pitch around note 60\r\ntw = (wmode > 0.5) ? ftom(wmult * bhz / max(dbw, 0.0625)) + wfine : 60 + wpitch + wfine + transpose;\r\ntr = (rmode > 0.5) ? ftom(rmult * bhz / max(dbr, 0.0625)) + rfine : 60 + rpitch + rfine + transpose;\r\npw = snap ? tw : smw + (tw - smw) * k;\r\npr = snap ? tr : smr + (tr - smr) * k;\r\n// Output level: Output dB plus the voice-count compensation 20*log10(1/NV), smoothed.\r\ntgain = dbtoa(output) / NV;\r\ng = first ? tgain : smgain + (tgain - smgain) * k;\r\n// Declick gate (~5 ms one-pole on the gate, D1 in v0.1-core.md)\r\nke = 1 - exp(-1 / (0.005 * samplerate));\r\nenv = genv + (gon - genv) * ke;\r\nvel = smvel + (velocity - smvel) * ke;\r\nmw = smmw + (modwheel - smmw) * k;\r\n\r\n// ---- LFO rates (per voice they are spread below) ----\r\ndb1 = peek(divb, clamp(floor(l1note + 0.5), 0, 18), 0, interp = \"none\", boundmode = \"ignore\");\r\ndb2 = peek(divb, clamp(floor(l2note + 0.5), 0, 18), 0, interp = \"none\", boundmode = \"ignore\");\r\nf1 = (l1mode > 0.5) ? bhz / max(db1, 0.0625) : l1rate;\r\nf2 = (l2mode > 0.5) ? bhz / max(db2, 0.0625) : l2rate;\r\nre1 = ((l1retrig > 0.5) * (l1retrig < 1.5) * noteedge) + ((l1retrig >= 1.5) * lbar);\r\nre2 = ((l2retrig > 0.5) * (l2retrig < 1.5) * noteedge) + ((l2retrig >= 1.5) * lbar);\r\npo1 = l1phase / 360;\r\npo2 = l2phase / 360;\r\n\r\n// ---- mod slots: source masks and per-target coefficients (computed once per sample) ----\r\nd1 = m1depth * 0.01;\r\nd2 = m2depth * 0.01;\r\nd3 = m3depth * 0.01;\r\nd4 = m4depth * 0.01;\r\n// pitch targets use a cubic depth curve (fine at small depths, +-24 st at 100 %)\r\nq1 = 24 * d1 * d1 * d1;\r\nq2 = 24 * d2 * d2 * d2;\r\nq3 = 24 * d3 * d3 * d3;\r\nq4 = 24 * d4 * d4 * d4;\r\nt1 = floor(m1tgt + 0.5);\r\nt2 = floor(m2tgt + 0.5);\r\nt3 = floor(m3tgt + 0.5);\r\nt4 = floor(m4tgt + 0.5);\r\ns1 = floor(m1src + 0.5);\r\ns2 = floor(m2src + 0.5);\r\ns3 = floor(m3src + 0.5);\r\ns4 = floor(m4src + 0.5);\r\n// global part of each slot's source (Velocity, Mod Wheel are unipolar 0..1)\r\ngs1 = (s1 == 4) * vel + (s1 == 5) * mw;\r\ngs2 = (s2 == 4) * vel + (s2 == 5) * mw;\r\ngs3 = (s3 == 4) * vel + (s3 == 5) * mw;\r\ngs4 = (s4 == 4) * vel + (s4 == 5) * mw;\r\n\r\n// ---- tone constants ----\r\nnyq = 0.45 * samplerate;\r\nrq = bres * 0.01;\r\ns24 = bslope > 0.5;\r\nrej = bmode > 0.5;\r\n// SVF damping k = 1/Q: 24 dB = Butterworth stage (Q 0.5412) + resonant stage (Q 1.3066 .. 18);\r\n// 12 dB = one resonant stage (Q 0.7071 .. 18).\r\nkres = s24 ? 1 / (1.3066 * pow(18 / 1.3066, rq)) : 1 / (0.7071 * pow(18 / 0.7071, rq));\r\nkst1 = s24 ? 1.8478 : kres;\r\ndgain = dbtoa(drive);\r\ndwet = clamp(drive * 0.5, 0, 1);\r\ndnorm = 1 / tanh(dgain);\r\nfbk = rsfb * 0.01;\r\ncnorm = sqrt(1 - fbk * fbk);\r\ncmix = rsmix * 0.01;\r\nrdel = cwi;\r\n\r\nasymbase = wsym;\r\nrsym = (rdir > 0.5) ? 0.5 : 1;        // read Tri: one way = rising ramp, both = triangle\r\n\r\nsumL = 0;\r\nsumR = 0;\r\nfor (v = 0; v < NV; v += 1) {\r\n\tpos = (v - (NV - 1) * 0.5) / ((NV - 1) * 0.5);   // -1..1 across the voices\r\n\tu = (pos + 1) * 0.5;                              // 0..1\r\n\r\n\t// ---- mod sources of this voice ----\r\n\t// LFO 1 / 2: per-voice rate spread up to +-half an octave, retrigger, phase offset (R3)\r\n\tlp1 = re1 > 0.5 ? 0 : peek(ph, v, 2, interp = \"none\", boundmode = \"ignore\");\r\n\tlp2 = re2 > 0.5 ? 0 : peek(ph, v, 3, interp = \"none\", boundmode = \"ignore\");\r\n\tn1 = lp1 + f1 * exp2(l1spread * 0.005 * pos) / samplerate;\r\n\tn2 = lp2 + f2 * exp2(l2spread * 0.005 * pos) / samplerate;\r\n\tw1 = n1 >= 1;\r\n\tw2 = n2 >= 1;\r\n\tr1p = peek(rnd, v, 0, interp = \"none\", boundmode = \"ignore\");\r\n\tr1n = peek(rnd, v, 1, interp = \"none\", boundmode = \"ignore\");\r\n\tr2p = peek(rnd, v, 2, interp = \"none\", boundmode = \"ignore\");\r\n\tr2n = peek(rnd, v, 3, interp = \"none\", boundmode = \"ignore\");\r\n\t// drift: slow smooth random, 0.07 .. 0.13 Hz per voice\r\n\tdp = peek(ph, v, 4, interp = \"none\", boundmode = \"ignore\");\r\n\tdn = dp + (0.07 + 0.015 * v) / samplerate;\r\n\twd = dn >= 1;\r\n\trdp = peek(rnd, v, 4, interp = \"none\", boundmode = \"ignore\");\r\n\trdn = peek(rnd, v, 5, interp = \"none\", boundmode = \"ignore\");\r\n\tseed = peek(rnd, v, 6, interp = \"none\", boundmode = \"ignore\");\r\n\t// new random values at each cycle wrap (one generator step per wrap)\r\n\tsa = lcg(seed);\r\n\tsb = lcg(sa);\r\n\tsc = lcg(sb);\r\n\tnseed = (w1 + w2 + wd > 0.5) ? sc : seed;\r\n\tr1pn = w1 ? r1n : r1p;\r\n\tr1nn = w1 ? sa / 2147483647 * 2 - 1 : r1n;\r\n\tr2pn = w2 ? r2n : r2p;\r\n\tr2nn = w2 ? sb / 2147483647 * 2 - 1 : r2n;\r\n\trdpn = wd ? rdn : rdp;\r\n\trdnn = wd ? sc / 2147483647 * 2 - 1 : rdn;\r\n\tpoke(rnd, r1pn, v, 0, 0);\r\n\tpoke(rnd, r1nn, v, 1, 0);\r\n\tpoke(rnd, r2pn, v, 2, 0);\r\n\tpoke(rnd, r2nn, v, 3, 0);\r\n\tpoke(rnd, rdpn, v, 4, 0);\r\n\tpoke(rnd, rdnn, v, 5, 0);\r\n\tpoke(rnd, nseed, v, 6, 0);\r\n\tnlp1 = wrap(n1, 0, 1);\r\n\tnlp2 = wrap(n2, 0, 1);\r\n\tndp = wrap(dn, 0, 1);\r\n\tpoke(ph, nlp1, v, 2, 0);\r\n\tpoke(ph, nlp2, v, 3, 0);\r\n\tpoke(ph, ndp, v, 4, 0);\r\n\tlv1 = lfoshape(wrap(lp1 + po1, 0, 1), l1shape, r1p, r1n);\r\n\tlv2 = lfoshape(wrap(lp2 + po2, 0, 1), l2shape, r2p, r2n);\r\n\tdrv = rdp + (rdn - rdp) * (0.5 - 0.5 * cos(pi * dp));\r\n\r\n\t// slot sources for this voice\r\n\tv1 = (s1 == 1) * lv1 + (s1 == 2) * lv2 + (s1 == 3) * drv + gs1;\r\n\tv2 = (s2 == 1) * lv1 + (s2 == 2) * lv2 + (s2 == 3) * drv + gs2;\r\n\tv3 = (s3 == 1) * lv1 + (s3 == 2) * lv2 + (s3 == 3) * drv + gs3;\r\n\tv4 = (s4 == 1) * lv1 + (s4 == 2) * lv2 + (s4 == 3) * drv + gs4;\r\n\t// target sums (units per target in docs/v0.2-build.md)\r\n\tmwp = (t1 == 1) * q1 * v1 + (t2 == 1) * q2 * v2 + (t3 == 1) * q3 * v3 + (t4 == 1) * q4 * v4;\r\n\tmrp = (t1 == 2) * q1 * v1 + (t2 == 2) * q2 * v2 + (t3 == 2) * q3 * v3 + (t4 == 2) * q4 * v4;\r\n\tmsz = (t1 == 3) * d1 * v1 + (t2 == 3) * d2 * v2 + (t3 == 3) * d3 * v3 + (t4 == 3) * d4 * v4;\r\n\tmws = (t1 == 4) * d1 * v1 + (t2 == 4) * d2 * v2 + (t3 == 4) * d3 * v3 + (t4 == 4) * d4 * v4;\r\n\tmsp = (t1 == 5) * d1 * v1 + (t2 == 5) * d2 * v2 + (t3 == 5) * d3 * v3 + (t4 == 5) * d4 * v4;\r\n\tmbc = (t1 == 6) * d1 * v1 + (t2 == 6) * d2 * v2 + (t3 == 6) * d3 * v3 + (t4 == 6) * d4 * v4;\r\n\tmbw = (t1 == 7) * d1 * v1 + (t2 == 7) * d2 * v2 + (t3 == 7) * d3 * v3 + (t4 == 7) * d4 * v4;\r\n\tmrf = (t1 == 8) * d1 * v1 + (t2 == 8) * d2 * v2 + (t3 == 8) * d3 * v3 + (t4 == 8) * d4 * v4;\r\n\tmwd = (t1 == 9) * d1 * v1 + (t2 == 9) * d2 * v2 + (t3 == 9) * d3 * v3 + (t4 == 9) * d4 * v4;\r\n\tmout = (t1 == 10) * d1 * v1 + (t2 == 10) * d2 * v2 + (t3 == 10) * d3 * v3 + (t4 == 10) * d4 * v4;\r\n\r\n\t// ---- pointers ----\r\n\t// read spread (V - 0.5)/Vcs - 0.5 semitones with V = v + 1; Read Spread target adds +-6 st\r\n\tnoter = pr + (rspread + 6 * msp) * ((v + 0.5) / NV - 0.5) + mrp;\r\n\tnotew = pw + mwp;\r\n\tfw = mtof(notew);\r\n\tfr = mtof(noter);\r\n\tincw = fw / samplerate;\r\n\tincr = fr / samplerate;\r\n\tphw = wrs ? 0 : peek(ph, v, 0, interp = \"none\", boundmode = \"ignore\");\r\n\tphr = rrs ? 0 : peek(ph, v, 1, interp = \"none\", boundmode = \"ignore\");\r\n\tnphw = wrap(phw + incw, 0, 1);\r\n\tnphr = wrap(phr + incr, 0, 1);\r\n\tpoke(ph, nphw, v, 0, 0);\r\n\tpoke(ph, nphr, v, 1, 0);\r\n\r\n\t// shapes; the anti-aliased ramp may leave 0..1 slightly, positions and values are clipped (C4)\r\n\tbw = blep(phw, incw);\r\n\tbr = blep(phr, incr);\r\n\trampw = (aaramp > 0.5) ? phw - 0.5 * bw : phw;\r\n\trampr = (aaramp > 0.5) ? phr - 0.5 * br : phr;\r\n\tsymw = clamp(asymbase + mws, -1, 1);\r\n\ttriw = skewtri(phw, (1 + symw) * 0.5);           // 0..1 (Tri)\r\n\ttripm = 2 * triw - 1;                            // -1..1 (Tri +-, the original's lo, R22)\r\n\ttrir = skewtri(phr, rsym);\r\n\trd = (rshape > 0.5) ? trir : rampr;              // read phase = written data\r\n\txw = (wshape < 0.5) ? rampw : ((wshape < 1.5) ? triw : ((wshape < 2.5) ? tripm : rd));\r\n\tsz = clamp(size * exp2(3 * msz), 0.001, 1);      // Size target: +-3 octaves\r\n\twpos = xw * sz;\r\n\trpos = rd * gon * sz;                            // 0 while the gate is closed (original: RX = phi*G*size)\r\n\r\n\t// Same-sample order: WRITE first, then READ (statement order is the order in GenExpr).\r\n\t// Index floor, clipped to the row like the original's Audio Table (C4: Clip); values clipped to 0..1.\r\n\twi = clamp(floor(wpos * N), 0, N - 1);\r\n\twval = clamp(rd, 0, 1);\r\n\tif (we > 0.5) {\r\n\t\tpoke(atab, wval, wi, v, 0);\r\n\t}\r\n\tri = rpos * N;\r\n\ti0 = clamp(floor(ri), 0, N - 1);\r\n\tfrac = clamp(ri - i0, 0, 1);\r\n\ta0 = peek(atab, i0, v, interp = \"none\", boundmode = \"ignore\");\r\n\ta1 = peek(atab, wrap(i0 + 1, 0, N), v, interp = \"none\", boundmode = \"ignore\");\r\n\tval = (smoothread > 0.5) ? a0 + (a1 - a0) * frac : a0;\r\n\ty = 2 * val - 1;\r\n\r\n\t// ---- Drive (R18): tanh, normalised so +-1 stays +-1; faded in over the first 2 dB ----\r\n\tyd = y + dwet * (tanh(y * dgain) * dnorm - y);\r\n\r\n\t// ---- Band (R16, R17): lower edge filter A, upper edge filter B, TPT SVFs (Zavalishin) ----\r\n\tcen0 = bcenter * exp2(bspread * 0.02 * pos + 4 * mbc);\r\n\tcen = cen0 * exp2(bfm * 0.04 * y);               // audio-rate FM from the unfiltered core\r\n\twid = clamp(bwidth + 5 * mbw, 0.2, 10);\r\n\tflo = clamp(cen * exp2(-0.5 * wid), 10, nyq);\r\n\tfhi = clamp(cen * exp2(0.5 * wid), 10, nyq);\r\n\tga = tan(pi * flo / samplerate);\r\n\tgb = tan(pi * fhi / samplerate);\r\n\t// coefficients: stage 1 (k = kst1), stage 2 (k = kres)\r\n\taa1 = 1 / (1 + ga * (ga + kst1));\r\n\taa2 = ga * aa1;\r\n\taa3 = ga * aa2;\r\n\tab1 = 1 / (1 + ga * (ga + kres));\r\n\tab2 = ga * ab1;\r\n\tab3 = ga * ab2;\r\n\tba1 = 1 / (1 + gb * (gb + kst1));\r\n\tba2 = gb * ba1;\r\n\tba3 = gb * ba2;\r\n\tbb1 = 1 / (1 + gb * (gb + kres));\r\n\tbb2 = gb * bb1;\r\n\tbb3 = gb * bb2;\r\n\t// filter A stage 1 (input yd): Pass uses its HP, Reject its LP\r\n\tsA1 = peek(flt, v, 0, interp = \"none\", boundmode = \"ignore\");\r\n\tsA2 = peek(flt, v, 1, interp = \"none\", boundmode = \"ignore\");\r\n\tx3 = yd - sA2;\r\n\tx1 = aa1 * sA1 + aa2 * x3;\r\n\tx2 = sA2 + aa2 * sA1 + aa3 * x3;\r\n\tnA1 = fixdenorm(2 * x1 - sA1);\r\n\tnA2 = fixdenorm(2 * x2 - sA2);\r\n\toA1 = rej ? x2 : yd - kst1 * x1 - x2;\r\n\tpoke(flt, nA1, v, 0, 0);\r\n\tpoke(flt, nA2, v, 1, 0);\r\n\t// filter A stage 2\r\n\tsB1 = peek(flt, v, 2, interp = \"none\", boundmode = \"ignore\");\r\n\tsB2 = peek(flt, v, 3, interp = \"none\", boundmode = \"ignore\");\r\n\tx3 = oA1 - sB2;\r\n\tx1 = ab1 * sB1 + ab2 * x3;\r\n\tx2 = sB2 + ab2 * sB1 + ab3 * x3;\r\n\tnB1 = fixdenorm(2 * x1 - sB1);\r\n\tnB2 = fixdenorm(2 * x2 - sB2);\r\n\toA2 = rej ? x2 : oA1 - kres * x1 - x2;\r\n\tpoke(flt, nB1, v, 2, 0);\r\n\tpoke(flt, nB2, v, 3, 0);\r\n\toutA = s24 ? oA2 : oA1;\r\n\t// filter B: Pass = LP of filter A's output, Reject = HP of the driven signal (parallel)\r\n\tinB = rej ? yd : outA;\r\n\tsC1 = peek(flt, v, 4, interp = \"none\", boundmode = \"ignore\");\r\n\tsC2 = peek(flt, v, 5, interp = \"none\", boundmode = \"ignore\");\r\n\tx3 = inB - sC2;\r\n\tx1 = ba1 * sC1 + ba2 * x3;\r\n\tx2 = sC2 + ba2 * sC1 + ba3 * x3;\r\n\tnC1 = fixdenorm(2 * x1 - sC1);\r\n\tnC2 = fixdenorm(2 * x2 - sC2);\r\n\toB1 = rej ? inB - kst1 * x1 - x2 : x2;\r\n\tpoke(flt, nC1, v, 4, 0);\r\n\tpoke(flt, nC2, v, 5, 0);\r\n\tsD1 = peek(flt, v, 6, interp = \"none\", boundmode = \"ignore\");\r\n\tsD2 = peek(flt, v, 7, interp = \"none\", boundmode = \"ignore\");\r\n\tx3 = oB1 - sD2;\r\n\tx1 = bb1 * sD1 + bb2 * x3;\r\n\tx2 = sD2 + bb2 * sD1 + bb3 * x3;\r\n\tnD1 = fixdenorm(2 * x1 - sD1);\r\n\tnD2 = fixdenorm(2 * x2 - sD2);\r\n\toB2 = rej ? oB1 - kres * x1 - x2 : x2;\r\n\tpoke(flt, nD1, v, 6, 0);\r\n\tpoke(flt, nD2, v, 7, 0);\r\n\toutB = s24 ? oB2 : oB1;\r\n\tband = rej ? outA + outB : outB;\r\n\r\n\t// ---- Resonator (R18): feedback comb, + peaks / - notches, Mix 0 = bypass ----\r\n\trsf = clamp(((rstrack > 0.5) ? fr : rsfreq) * exp2(3 * mrf), 20, 5000);\r\n\tdl = samplerate / rsf;\r\n\trp = wrap(rdel - dl, 0, CB);\r\n\tj0 = floor(rp);\r\n\tfj = rp - j0;\r\n\tc0 = peek(cbuf, j0, v, interp = \"none\", boundmode = \"ignore\");\r\n\tc1 = peek(cbuf, wrap(j0 + 1, 0, CB), v, interp = \"none\", boundmode = \"ignore\");\r\n\tycomb = band + fbk * (c0 + (c1 - c0) * fj);\r\n\tcw = fixdenorm(ycomb);\r\n\tpoke(cbuf, cw, rdel, v, 0);\r\n\tvo = band + cmix * (ycomb * cnorm - band);\r\n\r\n\t// ---- level, pan, sum ----\r\n\tgv = dbtoa(clamp(24 * mout, -60, 12));            // Output target: +-24 dB\r\n\tpan = clamp((width + mwd) * pos, -1, 1);          // equal-power pan, Width target +-1\r\n\tang = (pan + 1) * pi * 0.25;\r\n\tsumL += vo * gv * cos(ang);\r\n\tsumR += vo * gv * sin(ang);\r\n\r\n\t// ---- display data ----\r\n\tpoke(aheads, wi / N, v, 0, 0);\r\n\tpoke(aheads, clamp(rpos, 0, 1), v, 1, 0);\r\n\tpoke(aheads, we, v, 2, 0);\r\n\tpoke(aheads, sz, v, 3, 0);\r\n\tpoke(aheads, fw, v, 4, 0);\r\n\tpoke(aheads, fr, v, 5, 0);\r\n\tpoke(aheads, cen0, v, 6, 0);\r\n\tpoke(aheads, wid, v, 7, 0);\r\n\tpoke(aheads, rsf, v, 8, 0);\r\n}\r\npoke(aheads, samplerate, 0, 9, 0);\r\npoke(aheads, env, 2, 9, 0);\r\npoke(aheads, 60 * bhz, 3, 9, 0);\r\npoke(aheads, isplay, 4, 9, 0);\r\n\r\nsmw = pw;\r\nsmr = pr;\r\nsmgain = g;\r\nsmvel = vel;\r\nsmmw = mw;\r\ngenv = env;\r\nprevgate = gon;\r\nprevsync = syn;\r\nprevnote = non;\r\nprevplay = isplay;\r\nprevbar = in4;\r\nbarcount = bc;\r\ncwi = wrap(cwi + 1, 0, CB);\r\ninited = 1;\r\n\r\n// Output, DC blocker (5 Hz one-pole high-pass), optional soft clip (R18)\r\noutl = sumL * g * env;\r\noutr = sumR * g * env;\r\ndcr = 1 - twopi * 5 / samplerate;\r\nhl = outl - dcxl + dcr * dcyl;\r\nhr = outr - dcxr + dcr * dcyr;\r\ndcxl = outl;\r\ndcyl = fixdenorm(hl);\r\ndcxr = outr;\r\ndcyr = fixdenorm(hr);\r\ncl = (softclip > 0.5) ? tanh(hl) : hl;\r\ncr = (softclip > 0.5) ? tanh(hr) : hr;\r\n\r\n// Safety stage (development builds): no NaN/inf/denormals, hard clip to -1..1.\r\nout1 = clip(fixdenorm(fixnan(cl)), -1, 1);\r\nout2 = clip(fixdenorm(fixnan(cr)), -1, 1);",
